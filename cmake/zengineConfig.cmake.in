@PACKAGE_INIT@

# Zengine's consumer surface: the `zengine::` targets zengineTargets.cmake defines, spelled as
# this repository's own link lines spell them (docs/getting-started.md).

# ---- this package's own paths, resolved first -------------------------------------------
# `PACKAGE_PREFIX_DIR` is an ordinary variable in the including scope, and find_dependency(loom)
# below includes the Loom's config, which sets it to the Loom's prefix: anything of ours resolved
# after that resolves against another install tree. So the artifact locations are computed now,
# and the prefix is kept under a name of our own.
set(ZENGINE_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")

# An artifact is the physical loadable file, opened by path and never linked, so these are files,
# not targets; weave and provider are surfaces it may expose (`zengine-operators-basic` is a
# provider, with no participant to load onto a bus). ZENGINE_RUNTIME_ARTIFACTS lists the stems
# this install carries and ZENGINE_ARTIFACT_DIR is where they are: a host names
# `${ZENGINE_ARTIFACT_DIR}/zengine-timer${CMAKE_SHARED_LIBRARY_SUFFIX}` or copies it beside itself.
# Built against a Loom that cannot host images, the list is empty and says so.
set(ZENGINE_RUNTIME_ARTIFACTS "@ZENGINE_INSTALLED_ARTIFACTS@")
if(ZENGINE_RUNTIME_ARTIFACTS)
    set_and_check(ZENGINE_ARTIFACT_DIR "@PACKAGE_ZENGINE_INSTALL_ARTIFACTDIR@")
else()
    set(ZENGINE_ARTIFACT_DIR "")
    message(STATUS
        "zengine: this package carries no loadable artifacts -- it was built against a Loom "
        "with no kernel. The exported targets and public headers are unaffected.")
endif()

# ---- the substrate underneath ------------------------------------------------------------
#
# The Loom is a PUBLIC dependency of this package, not a private one: every exported target's
# headers include <zen/...>, and the targets themselves name loom::core and loom::switchboard.
# So it is resolved here rather than left for the consumer to discover from a link error --
# find_package(zengine) is meant to be the only line a project has to write.
include(CMakeFindDependencyMacro)
find_dependency(loom 0.1)

include("${CMAKE_CURRENT_LIST_DIR}/zengineTargets.cmake")

check_required_components(zengine)
