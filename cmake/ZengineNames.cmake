#
# Colours, text sizes, fonts and styles by name, generated from JSON at configure time: a C++ name
# for each colour, size, font and style a pool or a pane's own values declare, and a palette for each
# theme, so a name nobody declared does not build and a theme is data. Installed with the package,
# so a stranger's pane generates its own values as Zengine's own do. The JSON's form and the C++ it
# gives: graphics/docs/graphics.md, "Colours by name" and "Text: styles, sizes, fonts, weight".

if(CMAKE_VERSION VERSION_LESS 3.22)
    message(FATAL_ERROR "zengine: colours by name are generated with CMake 3.22 or newer; this is "
                        "CMake ${CMAKE_VERSION}")
endif()

set(ZENGINE_NAMES_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(_zengine_names_fail file what)
    message(FATAL_ERROR "zengine: ${file}: ${what}")
endfunction()

# <out> = the member `key` of `json` as a string, or `default` where it is absent.
function(_zengine_names_get out json key default file)
    string(JSON type ERROR_VARIABLE err TYPE "${json}" "${key}")
    if(err)
        set(${out} "${default}" PARENT_SCOPE)
        return()
    endif()
    if(NOT type STREQUAL "STRING")
        _zengine_names_fail("${file}" "'${key}' is ${type}, not a string")
    endif()
    string(JSON value GET "${json}" "${key}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Every member of `json` is one of the keys named after it, else refused by name.
function(_zengine_names_keys json file where)
    string(JSON n LENGTH "${json}")
    if(n EQUAL 0)
        return()
    endif()
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${json}" ${i})
        if(NOT key IN_LIST ARGN)
            string(REPLACE ";" ", " known "${ARGN}")
            _zengine_names_fail("${file}" "${where} has '${key}', which is none of: ${known}")
        endif()
    endforeach()
endfunction()

function(_zengine_names_identifier name file)
    # The C++ words a name cannot be.
    set(keywords
        alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t char16_t
        char32_t class compl concept const consteval constexpr constinit const_cast continue co_await
        co_return co_yield decltype default delete do double dynamic_cast else enum explicit export
        extern false float for friend goto if inline int long mutable namespace new noexcept not
        not_eq nullptr operator or or_eq private protected public register reinterpret_cast requires
        return short signed sizeof static static_assert static_cast struct switch template this
        thread_local throw true try typedef typeid typename union unsigned using virtual void volatile
        wchar_t while xor xor_eq)
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR name IN_LIST keywords)
        _zengine_names_fail("${file}" "'${name}' cannot be a C++ name")
    endif()
endfunction()

# <out> = the C++ name a declared name is spelled as: the name itself, or, for a word Windows'
# headers define as a macro (`small`), the name with `_` after it (`sizes::small_`), which no
# macro there shadows. The name a draw sends is the declared one either way.
function(_zengine_names_cpp out name)
    set(macros small near far min max interface pascal cdecl IN OUT OPTIONAL)
    if(name IN_LIST macros)
        set(${out} "${name}_" PARENT_SCOPE)
    else()
        set(${out} "${name}" PARENT_SCOPE)
    endif()
endfunction()

# <out> = 0xRRGGBBAA from "#rrggbb" or "#rrggbbaa".
function(_zengine_names_rgba out color file)
    if(color MATCHES "^#([0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])$")
        string(TOLOWER "0x${CMAKE_MATCH_1}ff" v)
    elseif(color MATCHES "^#([0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])$")
        string(TOLOWER "0x${CMAKE_MATCH_1}" v)
    else()
        _zengine_names_fail("${file}" "'${color}' is not a colour: #rrggbb or #rrggbbaa")
    endif()
    set(${out} "${v}" PARENT_SCOPE)
endfunction()

function(_zengine_names_cells cells file)
    if(cells STREQUAL "")
        return()
    endif()
    set(colours "black|red|green|yellow|blue|magenta|cyan|white")
    if(NOT cells MATCHES "^(terminal default|(bright )?(${colours}))( bold)?$")
        _zengine_names_fail("${file}" "'${cells}' is not what a terminal shows: terminal default, or one of "
                                      "its sixteen inks (bright or not), perhaps bold")
    endif()
endfunction()

# A C++ string literal of `text`.
function(_zengine_names_literal out text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

# The colours of `json`'s `colors` member, each judged, as lists in the caller's scope:
# <prefix>_names and, a colour each, <prefix>_<name>_{color,like,about}.
function(_zengine_names_colors prefix json file need_color)
    string(JSON type ERROR_VARIABLE err TYPE "${json}" colors)
    if(err)
        _zengine_names_fail("${file}" "it has no 'colors'")
    endif()
    if(NOT type STREQUAL "ARRAY")
        _zengine_names_fail("${file}" "'colors' is ${type}, not a list")
    endif()
    string(JSON n LENGTH "${json}" colors)
    set(names "")
    if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
            string(JSON c GET "${json}" colors ${i})
            _zengine_names_keys("${c}" "${file}" "colour ${i}" name color like about)
            _zengine_names_get(name "${c}" name "" "${file}")
            _zengine_names_identifier("${name}" "${file}")
            if(name IN_LIST names)
                _zengine_names_fail("${file}" "'${name}' is declared twice")
            endif()
            list(APPEND names "${name}")
            _zengine_names_get(color "${c}" color "" "${file}")
            if(color STREQUAL "")
                if(need_color)
                    _zengine_names_fail("${file}" "'${name}' has no colour")
                endif()
                set(rgba "")
            else()
                _zengine_names_rgba(rgba "${color}" "${file}")
            endif()
            _zengine_names_get(like "${c}" like "" "${file}")
            _zengine_names_get(about "${c}" about "" "${file}")
            set(${prefix}_${name}_color "${rgba}" PARENT_SCOPE)
            set(${prefix}_${name}_like "${like}" PARENT_SCOPE)
            set(${prefix}_${name}_about "${about}" PARENT_SCOPE)
        endforeach()
    endif()
    set(${prefix}_names "${names}" PARENT_SCOPE)
endfunction()

# A terminal file (`zengine-terminal` version 1, graphics/terminal.json's form) read and judged:
# its borders, three characters or none, and each colour's ink and fill, as lists in the caller's
# scope: <prefix>_borders, <prefix>_inks and, a colour each, <prefix>_ink_<name>_{ink,fill}. Every
# colour it names is one `pool_names` holds; `name` is the file's own, "" where it may name none.
function(_zengine_names_inks prefix json file pool_names name)
    if(name STREQUAL "")
        _zengine_names_keys("${json}" "${file}" "the terminal file" format format_version about
                            borders inks)
    else()
        _zengine_names_keys("${json}" "${file}" "the terminal file" format format_version name
                            summary about borders inks)
        _zengine_names_get(own_name "${json}" name "" "${file}")
        if(NOT own_name STREQUAL name)
            _zengine_names_fail("${file}" "it names the theme '${own_name}', not '${name}', whose "
                                          "terminal file it stands as")
        endif()
    endif()
    string(JSON version ERROR_VARIABLE verr GET "${json}" format_version)
    if(verr OR NOT version EQUAL 1)
        _zengine_names_fail("${file}" "it is terminal file version ${version}; a terminal file is "
                                      "read at version 1")
    endif()
    _zengine_names_get(borders "${json}" borders "" "${file}")
    string(LENGTH "${borders}" borders_len)
    if(NOT borders_len EQUAL 0 AND NOT borders_len EQUAL 3)
        _zengine_names_fail("${file}" "its borders '${borders}' are not three characters: a "
                                      "corner, across and down")
    endif()
    set(names "")
    string(JSON type ERROR_VARIABLE err TYPE "${json}" inks)
    if(NOT err)
        if(NOT type STREQUAL "ARRAY")
            _zengine_names_fail("${file}" "'inks' is ${type}, not a list")
        endif()
        string(JSON n LENGTH "${json}" inks)
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON c GET "${json}" inks ${i})
                _zengine_names_keys("${c}" "${file}" "ink ${i}" name ink fill)
                _zengine_names_get(ink_name "${c}" name "" "${file}")
                if(NOT ink_name IN_LIST pool_names)
                    _zengine_names_fail("${file}" "it inks '${ink_name}', which the pool does not "
                                                  "declare")
                endif()
                if(ink_name IN_LIST names)
                    _zengine_names_fail("${file}" "'${ink_name}' is inked twice")
                endif()
                list(APPEND names "${ink_name}")
                _zengine_names_get(ink "${c}" ink "" "${file}")
                _zengine_names_cells("${ink}" "${file}")
                _zengine_names_get(fill "${c}" fill "" "${file}")
                string(LENGTH "${fill}" fill_len)
                if(fill_len GREATER 1 OR (fill_len EQUAL 1 AND NOT fill MATCHES "^[ -~]$"))
                    _zengine_names_fail("${file}" "'${ink_name}' fills with '${fill}': one "
                                                  "printable ASCII character, or none")
                endif()
                set(${prefix}_ink_${ink_name}_ink "${ink}" PARENT_SCOPE)
                set(${prefix}_ink_${ink_name}_fill "${fill}" PARENT_SCOPE)
            endforeach()
        endif()
    endif()
    set(${prefix}_borders "${borders}" PARENT_SCOPE)
    set(${prefix}_inks "${names}" PARENT_SCOPE)
endfunction()

# The sizes of `json`'s `sizes` member, each judged, as lists in the caller's scope: <prefix>_sizes
# and, a size each, <prefix>_size_<name>_{points,about}. No `sizes` member is no sizes.
function(_zengine_names_sizes prefix json file)
    set(names "")
    string(JSON type ERROR_VARIABLE err TYPE "${json}" sizes)
    if(NOT err)
        if(NOT type STREQUAL "ARRAY")
            _zengine_names_fail("${file}" "'sizes' is ${type}, not a list")
        endif()
        string(JSON n LENGTH "${json}" sizes)
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON s GET "${json}" sizes ${i})
                _zengine_names_keys("${s}" "${file}" "size ${i}" name points about)
                _zengine_names_get(name "${s}" name "" "${file}")
                _zengine_names_identifier("${name}" "${file}")
                if(name IN_LIST names)
                    _zengine_names_fail("${file}" "the size '${name}' is declared twice")
                endif()
                list(APPEND names "${name}")
                string(JSON ptype ERROR_VARIABLE perr TYPE "${s}" points)
                if(perr OR NOT ptype STREQUAL "NUMBER")
                    _zengine_names_fail("${file}" "the size '${name}' has no points")
                endif()
                string(JSON points GET "${s}" points)
                if(NOT points MATCHES "^[0-9]+$" OR points LESS 6 OR points GREATER 96)
                    _zengine_names_fail("${file}" "the size '${name}' stands at ${points} points: "
                                                  "a whole number from 6 to 96")
                endif()
                _zengine_names_get(about "${s}" about "" "${file}")
                set(${prefix}_size_${name}_points "${points}" PARENT_SCOPE)
                set(${prefix}_size_${name}_about "${about}" PARENT_SCOPE)
            endforeach()
        endif()
    endif()
    set(${prefix}_sizes "${names}" PARENT_SCOPE)
endfunction()

# The fonts of `json`'s `fonts` member, each judged, as lists in the caller's scope: <prefix>_fonts
# and, a font each, <prefix>_font_<name>_{face,about}. No `fonts` member is no fonts.
function(_zengine_names_fonts prefix json file)
    set(names "")
    string(JSON type ERROR_VARIABLE err TYPE "${json}" fonts)
    if(NOT err)
        if(NOT type STREQUAL "ARRAY")
            _zengine_names_fail("${file}" "'fonts' is ${type}, not a list")
        endif()
        string(JSON n LENGTH "${json}" fonts)
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON f GET "${json}" fonts ${i})
                _zengine_names_keys("${f}" "${file}" "font ${i}" name face about)
                _zengine_names_get(name "${f}" name "" "${file}")
                _zengine_names_identifier("${name}" "${file}")
                if(name IN_LIST names)
                    _zengine_names_fail("${file}" "the font '${name}' is declared twice")
                endif()
                list(APPEND names "${name}")
                _zengine_names_get(face "${f}" face "" "${file}")
                if(face STREQUAL "")
                    _zengine_names_fail("${file}" "the font '${name}' names no face")
                endif()
                _zengine_names_get(about "${f}" about "" "${file}")
                set(${prefix}_font_${name}_face "${face}" PARENT_SCOPE)
                set(${prefix}_font_${name}_about "${about}" PARENT_SCOPE)
            endforeach()
        endif()
    endif()
    set(${prefix}_fonts "${names}" PARENT_SCOPE)
endfunction()

# The styles of `json`'s `styles` member, each judged against the roots already read under
# <prefix> (its font, size and colour each one of them; its weight `regular` or `bold`), as lists
# in the caller's scope: <prefix>_styles and, a style each,
# <prefix>_style_<name>_{font,size,color,weight,about}. No `styles` member is no styles.
function(_zengine_names_styles prefix json file)
    set(names "")
    string(JSON type ERROR_VARIABLE err TYPE "${json}" styles)
    if(NOT err)
        if(NOT type STREQUAL "ARRAY")
            _zengine_names_fail("${file}" "'styles' is ${type}, not a list")
        endif()
        string(JSON n LENGTH "${json}" styles)
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON s GET "${json}" styles ${i})
                _zengine_names_keys("${s}" "${file}" "style ${i}" name font size color weight about)
                _zengine_names_get(name "${s}" name "" "${file}")
                _zengine_names_identifier("${name}" "${file}")
                if(name IN_LIST names)
                    _zengine_names_fail("${file}" "the style '${name}' is declared twice")
                endif()
                list(APPEND names "${name}")
                foreach(field font size color)
                    _zengine_names_get(v "${s}" ${field} "" "${file}")
                    if(field STREQUAL "font")
                        set(roots "${${prefix}_fonts}")
                    elseif(field STREQUAL "size")
                        set(roots "${${prefix}_sizes}")
                    else()
                        set(roots "${${prefix}_names}")
                    endif()
                    if(NOT v IN_LIST roots)
                        _zengine_names_fail("${file}" "the style '${name}' names the ${field} '${v}', "
                                                      "which the pool does not declare")
                    endif()
                    set(${prefix}_style_${name}_${field} "${v}" PARENT_SCOPE)
                endforeach()
                _zengine_names_get(weight "${s}" weight "regular" "${file}")
                if(NOT weight MATCHES "^(regular|bold)$")
                    _zengine_names_fail("${file}" "the style '${name}' weighs '${weight}': "
                                                  "regular or bold")
                endif()
                _zengine_names_get(about "${s}" about "" "${file}")
                set(${prefix}_style_${name}_weight "${weight}" PARENT_SCOPE)
                set(${prefix}_style_${name}_about "${about}" PARENT_SCOPE)
            endforeach()
        endif()
    endif()
    set(${prefix}_styles "${names}" PARENT_SCOPE)
endfunction()

# <out> = the namespace `ns` sits in, and `ns` itself where it sits in none.
function(_zengine_names_parent out ns)
    string(FIND "${ns}" "::" at REVERSE)
    if(at LESS 0)
        set(${out} "${ns}" PARENT_SCOPE)
    else()
        string(SUBSTRING "${ns}" 0 ${at} parent)
        set(${out} "${parent}" PARENT_SCOPE)
    endif()
endfunction()

function(_zengine_names_read out file format)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "zengine: no such file to generate names from: ${file}")
    endif()
    file(READ "${file}" json)
    string(JSON got ERROR_VARIABLE err GET "${json}" format)
    if(err)
        _zengine_names_fail("${file}" "it does not read as JSON with a 'format': ${err}")
    endif()
    if(NOT got STREQUAL format)
        _zengine_names_fail("${file}" "its format is '${got}', not '${format}'")
    endif()
    if(format STREQUAL "zengine-pool")
        string(JSON version ERROR_VARIABLE verr GET "${json}" format_version)
        if(verr OR NOT version EQUAL 3)
            _zengine_names_fail("${file}" "it is pool version ${version}; a pool is read from "
                                          "version 3, which declares its sizes from tiny to huge "
                                          "and the styles made of its roots beside its colours")
        endif()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    set(${out} "${json}" PARENT_SCOPE)
endfunction()

# The folder a target's generated headers live in, on its include path.
function(_zengine_names_folder out target)
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/zengine-names/${target}")
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
        target_include_directories(${target} INTERFACE "$<BUILD_INTERFACE:${dir}>")
    else()
        target_include_directories(${target} PUBLIC "$<BUILD_INTERFACE:${dir}>")
    endif()
    set(${out} "${dir}" PARENT_SCOPE)
endfunction()

# A header is written only when its bytes change, so a configure rebuilds nothing it need not.
function(_zengine_names_write path text)
    if(EXISTS "${path}")
        file(READ "${path}" old)
        if(old STREQUAL text)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${text}")
endfunction()

# zengine_names(<target> JSON <file> NAMESPACE <namespace> HEADER <include path>): a header naming
# each colour of a pool (`PoolColor`) or a pane's own values (`OwnColor`, with its default and the
# pool colour it is `like`) in <namespace>, and each size (`PoolSize`, or an own `OwnSize`), a
# pool's fonts (`PoolFont`) and styles (`PoolStyle`) in `sizes`, `fonts` and `styles` beside it. A
# pool declares the font `text` and the style `body`. A name is refused only where C++ cannot spell
# it, and spelled with `_` after it where Windows' headers make it a macro.
function(zengine_names target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "JSON;NAMESPACE;HEADER" "")
    if(NOT TARGET ${target} OR NOT arg_JSON OR NOT arg_NAMESPACE OR NOT arg_HEADER)
        message(FATAL_ERROR "zengine_names(<target> JSON <file> NAMESPACE <namespace> "
                            "HEADER <include path>)")
    endif()
    get_filename_component(file "${arg_JSON}" ABSOLUTE)
    file(READ "${file}" json)
    string(JSON format ERROR_VARIABLE err GET "${json}" format)
    if(err OR NOT format MATCHES "^zengine-(pool|own|slots)$")
        _zengine_names_fail("${file}" "its format is none of 'zengine-pool', 'zengine-own' and "
                                      "'zengine-slots'")
    endif()
    _zengine_names_read(json "${file}" "${format}")
    if(format STREQUAL "zengine-pool")
        _zengine_names_keys("${json}" "${file}" "the pool" format format_version about
                            colors sizes fonts styles)
    elseif(format STREQUAL "zengine-own")
        string(JSON own_version ERROR_VARIABLE own_err GET "${json}" format_version)
        if(NOT own_version EQUAL 1)
            _zengine_names_fail("${file}" "it is own values version ${own_version}; own values "
                                          "are read at version 1")
        endif()
        _zengine_names_keys("${json}" "${file}" "the own values" format format_version about role
                            colors sizes)
    else()
        # Slots, as a pane's own values were named before: read as own values. Version 2 names its
        # role `role`; a version-1 file named it `office`, read as the same.
        string(JSON slots_version ERROR_VARIABLE slots_err GET "${json}" format_version)
        if(slots_version EQUAL 2)
            _zengine_names_keys("${json}" "${file}" "the slots" format format_version about role
                                colors sizes)
        elseif(slots_version EQUAL 1)
            _zengine_names_keys("${json}" "${file}" "the slots" format format_version about office
                                colors sizes)
        else()
            _zengine_names_fail("${file}" "it is slots version ${slots_version}; slots are read at "
                                          "version 2, which names the role `role`, and at 1, "
                                          "which named it `office`")
        endif()
    endif()
    _zengine_names_colors(c "${json}" "${file}" TRUE)
    _zengine_names_sizes(c "${json}" "${file}")
    _zengine_names_fonts(c "${json}" "${file}")
    set(c_styles "")
    if(format STREQUAL "zengine-pool")
        _zengine_names_styles(c "${json}" "${file}")
        if(NOT "text" IN_LIST c_fonts)
            _zengine_names_fail("${file}" "the pool declares no font 'text', the font a style "
                                          "naming none is set in")
        endif()
        if(NOT "body" IN_LIST c_styles)
            _zengine_names_fail("${file}" "the pool declares no style 'body', the style a text "
                                          "naming none is set in")
        endif()
    endif()
    _zengine_names_parent(parent "${arg_NAMESPACE}")
    get_filename_component(source "${file}" NAME)
    set(text "// Generated by zengine_names() from ${source}: edit the JSON, never this file.\n\n")
    string(APPEND text "#pragma once\n\n#include \"graphics/color.hpp\"\n"
                       "#include \"graphics/text_style.hpp\"\n\nnamespace ${arg_NAMESPACE} {\n")
    foreach(name IN LISTS c_names)
        _zengine_names_cpp(cpp "${name}")
        if(NOT c_${name}_about STREQUAL "")
            string(APPEND text "/// ${c_${name}_about}\n")
        endif()
        if(format STREQUAL "zengine-pool")
            string(APPEND text "inline constexpr ::zengine::graphics::PoolColor ${cpp}{\"${name}\"};\n")
        else()
            _zengine_names_literal(like "${c_${name}_like}")
            string(APPEND text "inline constexpr ::zengine::graphics::OwnColor ${cpp}{\"${name}\", "
                               "${c_${name}_color}u, ${like}};\n")
        endif()
    endforeach()
    string(APPEND text "} // namespace ${arg_NAMESPACE}\n")
    if(c_sizes)
        string(APPEND text "\nnamespace ${parent}::sizes {\n")
        foreach(name IN LISTS c_sizes)
            _zengine_names_cpp(cpp "${name}")
            if(NOT c_size_${name}_about STREQUAL "")
                string(APPEND text "/// ${c_size_${name}_about}\n")
            endif()
            if(format STREQUAL "zengine-pool")
                string(APPEND text "inline constexpr ::zengine::graphics::PoolSize ${cpp}{\"${name}\"};\n")
            else()
                string(APPEND text "inline constexpr ::zengine::graphics::OwnSize ${cpp}{\"${name}\", "
                                   "${c_size_${name}_points}};\n")
            endif()
        endforeach()
        string(APPEND text "} // namespace ${parent}::sizes\n")
    endif()
    if(c_fonts)
        string(APPEND text "\nnamespace ${parent}::fonts {\n")
        foreach(name IN LISTS c_fonts)
            _zengine_names_cpp(cpp "${name}")
            if(NOT c_font_${name}_about STREQUAL "")
                string(APPEND text "/// ${c_font_${name}_about}\n")
            endif()
            string(APPEND text "inline constexpr ::zengine::graphics::PoolFont ${cpp}{\"${name}\"};\n")
        endforeach()
        string(APPEND text "} // namespace ${parent}::fonts\n")
    endif()
    if(c_styles)
        string(APPEND text "\nnamespace ${parent}::styles {\n")
        foreach(name IN LISTS c_styles)
            _zengine_names_cpp(cpp "${name}")
            if(NOT c_style_${name}_about STREQUAL "")
                string(APPEND text "/// ${c_style_${name}_about}\n")
            endif()
            string(APPEND text "inline constexpr ::zengine::graphics::PoolStyle ${cpp}{\"${name}\"};\n")
        endforeach()
        string(APPEND text "} // namespace ${parent}::styles\n")
    endif()
    _zengine_names_folder(dir ${target})
    _zengine_names_write("${dir}/${arg_HEADER}" "${text}")
endfunction()

# One PaletteColor's initializer.
function(_zengine_names_entry out name color)
    set(${out} "{\"${name}\", ${color}}" PARENT_SCOPE)
endfunction()

# One TerminalLook's initializer: each colour of `names` inked as <prefix>_ink_<name>_{ink,fill}
# says, and the borders.
function(_zengine_names_look out prefix names borders)
    set(entries "")
    foreach(n IN LISTS names)
        _zengine_names_literal(ink "${${prefix}_ink_${n}_ink}")
        _zengine_names_literal(fill "${${prefix}_ink_${n}_fill}")
        list(APPEND entries "{\"${n}\", ${ink}, ${fill}}")
    endforeach()
    string(JOIN ", " body ${entries})
    _zengine_names_literal(b "${borders}")
    set(${out} "::zengine::graphics::TerminalLook{{${body}}, ${b}}" PARENT_SCOPE)
endfunction()

# zengine_palettes(<target> POOL <file> TERMINAL <file> THEMES <file>... NAMESPACE <namespace>
# HEADER <path>): each theme -- a window file (`zengine-theme` version 3) and its terminal file
# beside it, `<name>.terminal.json` -- as a `PaletteOffered`: its look over the pool's defaults and
# its terminal look over the terminal's; with `built_in()`, the pool's own, `terminal()`, the
# terminal's own, and `shipped()`.
function(zengine_palettes target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "POOL;TERMINAL;NAMESPACE;HEADER" "THEMES")
    if(NOT TARGET ${target} OR NOT arg_POOL OR NOT arg_TERMINAL OR NOT arg_NAMESPACE OR
       NOT arg_HEADER)
        message(FATAL_ERROR "zengine_palettes(<target> POOL <file> TERMINAL <file> THEMES "
                            "<file>... NAMESPACE <namespace> HEADER <include path>)")
    endif()
    get_filename_component(pool_file "${arg_POOL}" ABSOLUTE)
    _zengine_names_read(pool "${pool_file}" zengine-pool)
    _zengine_names_colors(p "${pool}" "${pool_file}" TRUE)
    _zengine_names_sizes(p "${pool}" "${pool_file}")
    _zengine_names_fonts(p "${pool}" "${pool_file}")
    _zengine_names_styles(p "${pool}" "${pool_file}")
    get_filename_component(terminal_file "${arg_TERMINAL}" ABSOLUTE)
    _zengine_names_read(term "${terminal_file}" zengine-terminal)
    _zengine_names_inks(d "${term}" "${terminal_file}" "${p_names}" "")
    if(d_borders STREQUAL "")
        _zengine_names_fail("${terminal_file}" "the terminal's own look names no borders")
    endif()

    get_filename_component(source "${pool_file}" NAME)
    set(text "// Generated by zengine_palettes() from ${source}, the terminal's look and its themes: ")
    string(APPEND text "edit the JSON, never this file.\n\n#pragma once\n\n")
    string(APPEND text "#include \"graphics/text_style.hpp\"\n#include \"graphics/vocabulary.hpp\"\n\n")
    string(APPEND text "#include <vector>\n\nnamespace ${arg_NAMESPACE} {\n\n")

    # The terminal's own look, each colour as its file inks it.
    _zengine_names_look(look d "${d_inks}" "${d_borders}")
    string(APPEND text "/// The terminal's own look: what a terminal window shows where no palette sets it.\n")
    string(APPEND text "inline ::zengine::graphics::TerminalLook terminal() {\n    return ${look};\n}\n\n")

    # The pool's own: every colour, font, size and style as it declares them.
    set(entries "")
    foreach(name IN LISTS p_names)
        _zengine_names_entry(e "${name}" "${p_${name}_color}")
        list(APPEND entries "${e}")
    endforeach()
    string(JOIN ",\n        " body ${entries})
    set(fonts "")
    foreach(name IN LISTS p_fonts)
        _zengine_names_literal(face "${p_font_${name}_face}")
        list(APPEND fonts "{\"${name}\", ${face}}")
    endforeach()
    string(JOIN ", " fonts_body ${fonts})
    string(APPEND text "/// The pool's own: what a window paints an area in that wears no palette it holds.\n")
    string(APPEND text "inline ::zengine::graphics::PaletteOffered built_in() {\n")
    string(APPEND text "    ::zengine::graphics::PaletteOffered p;\n    p.revision = 1;\n")
    string(APPEND text "    p.colors = {\n        ${body}};\n    p.fonts = {${fonts_body}};\n")
    _zengine_names_palette_types(types p "")
    string(APPEND text "${types}    p.terminal = terminal();\n    return p;\n}\n\n")

    set(made "")
    foreach(theme IN LISTS arg_THEMES)
        get_filename_component(theme_file "${theme}" ABSOLUTE)
        _zengine_names_read(t "${theme_file}" zengine-theme)
        string(JSON version GET "${t}" format_version)
        if(NOT version EQUAL 3)
            _zengine_names_fail("${theme_file}" "it is theme file version ${version}; a window "
                                                "file is read at version 3, whose colours are a "
                                                "window's alone, a terminal's look being its "
                                                "terminal file's, and whose own values are `own`")
        endif()
        _zengine_names_keys("${t}" "${theme_file}" "the theme" format format_version name summary
                            about colors fonts sizes styles own)
        _zengine_names_get(name "${t}" name "" "${theme_file}")
        _zengine_names_identifier("${name}" "${theme_file}")
        if(name IN_LIST made)
            _zengine_names_fail("${theme_file}" "a theme named '${name}' is given twice")
        endif()
        list(APPEND made "${name}")
        _zengine_names_get(summary "${t}" summary "" "${theme_file}")
        string(JSON no_colors_type ERROR_VARIABLE no_colors TYPE "${t}" colors)
        set(o_names "")
        if(NOT no_colors)
            _zengine_names_colors(o "${t}" "${theme_file}" TRUE)
        endif()
        foreach(n IN LISTS o_names)
            if(NOT n IN_LIST p_names)
                _zengine_names_fail("${theme_file}" "it colours '${n}', which the pool "
                                                    "(${source}) does not declare")
            endif()
        endforeach()
        set(entries "")
        foreach(n IN LISTS p_names)
            set(color "${p_${n}_color}")
            if(n IN_LIST o_names)
                set(color "${o_${n}_color}")
            endif()
            _zengine_names_entry(e "${n}" "${color}")
            list(APPEND entries "${e}")
        endforeach()
        string(JOIN ",\n        " body ${entries})

        # Its fonts, sizes and styles over the pool's, by name.
        set(q_fonts "")
        set(q_sizes "")
        set(q_styles "")
        _zengine_names_fonts(q "${t}" "${theme_file}")
        _zengine_names_sizes(q "${t}" "${theme_file}")
        foreach(n IN LISTS q_fonts)
            if(NOT n IN_LIST p_fonts)
                _zengine_names_fail("${theme_file}" "it gives the font '${n}', which the pool "
                                                    "does not declare")
            endif()
        endforeach()
        foreach(n IN LISTS q_sizes)
            if(NOT n IN_LIST p_sizes)
                _zengine_names_fail("${theme_file}" "it gives the size '${n}', which the pool "
                                                    "does not declare")
            endif()
        endforeach()
        set(fonts "")
        foreach(n IN LISTS p_fonts)
            set(face "${p_font_${n}_face}")
            if(n IN_LIST q_fonts)
                set(face "${q_font_${n}_face}")
            endif()
            _zengine_names_literal(face "${face}")
            list(APPEND fonts "{\"${n}\", ${face}}")
        endforeach()
        string(JOIN ", " fonts_body ${fonts})
        foreach(n IN LISTS p_sizes)
            if(n IN_LIST q_sizes)
                set(p_size_${n}_points "${q_size_${n}_points}")
            endif()
        endforeach()
        set(r_fonts "${p_fonts}")
        set(r_sizes "${p_sizes}")
        set(r_names "${p_names}")
        _zengine_names_styles(r "${t}" "${theme_file}")
        foreach(n IN LISTS r_styles)
            if(NOT n IN_LIST p_styles)
                _zengine_names_fail("${theme_file}" "it gives the style '${n}', which the pool "
                                                    "does not declare")
            endif()
        endforeach()
        _zengine_names_palette_types(types p r)

        # Each role's own values, as the theme gives them.
        set(own_text "")
        string(JSON own_type ERROR_VARIABLE no_own TYPE "${t}" own)
        if(NOT no_own)
            string(JSON ns LENGTH "${t}" own)
            if(ns GREATER 0)
                math(EXPR last "${ns} - 1")
                foreach(i RANGE ${last})
                    string(JSON s GET "${t}" own ${i})
                    _zengine_names_keys("${s}" "${theme_file}" "own ${i}" role colors)
                    _zengine_names_get(role "${s}" role "" "${theme_file}")
                    _zengine_names_colors(s "${s}" "${theme_file}" TRUE)
                    set(own_entries "")
                    foreach(n IN LISTS s_names)
                        _zengine_names_entry(e "${n}" "${s_${n}_color}")
                        list(APPEND own_entries "${e}")
                    endforeach()
                    string(JOIN ", " own_body ${own_entries})
                    _zengine_names_literal(role "${role}")
                    string(APPEND own_text "    p.own.push_back({${role}, {${own_body}}, {}, {}});\n")
                endforeach()
            endif()
        endif()

        # Its terminal look, from its terminal file beside it, over the terminal's own.
        get_filename_component(theme_dir "${theme_file}" DIRECTORY)
        set(theme_terminal "${theme_dir}/${name}.terminal.json")
        if(NOT EXISTS "${theme_terminal}")
            _zengine_names_fail("${theme_file}" "a theme built in names both its files, and "
                                                "${name}.terminal.json is not beside it")
        endif()
        _zengine_names_read(tt "${theme_terminal}" zengine-terminal)
        _zengine_names_inks(i "${tt}" "${theme_terminal}" "${p_names}" "${name}")
        set(look_names "")
        foreach(n IN LISTS p_names)
            set(m_ink_${n}_ink "")
            set(m_ink_${n}_fill "")
            if(n IN_LIST d_inks)
                set(m_ink_${n}_ink "${d_ink_${n}_ink}")
                set(m_ink_${n}_fill "${d_ink_${n}_fill}")
            endif()
            if(n IN_LIST i_inks)
                if(NOT i_ink_${n}_ink STREQUAL "")
                    set(m_ink_${n}_ink "${i_ink_${n}_ink}")
                endif()
                if(NOT i_ink_${n}_fill STREQUAL "")
                    set(m_ink_${n}_fill "${i_ink_${n}_fill}")
                endif()
            endif()
            if(n IN_LIST d_inks OR n IN_LIST i_inks)
                list(APPEND look_names "${n}")
            endif()
        endforeach()
        set(borders "${d_borders}")
        if(NOT i_borders STREQUAL "")
            set(borders "${i_borders}")
        endif()
        _zengine_names_look(look m "${look_names}" "${borders}")

        if(NOT summary STREQUAL "")
            string(APPEND text "/// ${name}: ${summary}.\n")
        endif()
        string(APPEND text "inline ::zengine::graphics::PaletteOffered ${name}() {\n")
        string(APPEND text "    ::zengine::graphics::PaletteOffered p;\n    p.palette = \"${name}\";\n")
        string(APPEND text "    p.revision = 1;\n    p.colors = {\n        ${body}};\n")
        string(APPEND text "    p.fonts = {${fonts_body}};\n${types}${own_text}")
        string(APPEND text "    p.terminal = ${look};\n    return p;\n}\n\n")
        # The pool's sizes as declared, for the next theme.
        _zengine_names_sizes(p "${pool}" "${pool_file}")
    endforeach()

    set(calls "")
    foreach(name IN LISTS made)
        list(APPEND calls "${name}()")
    endforeach()
    string(JOIN ", " calls_text ${calls})
    string(APPEND text "/// Every theme given, in the order given.\n")
    string(APPEND text "inline std::vector<::zengine::graphics::PaletteOffered> shipped() {\n")
    string(APPEND text "    return {${calls_text}};\n}\n\n} // namespace ${arg_NAMESPACE}\n")
    _zengine_names_folder(dir ${target})
    _zengine_names_write("${dir}/${arg_HEADER}" "${text}")
endfunction()

# <out> = the sizes' and styles' lines of a palette: the pool's sizes under <prefix> as they stand,
# and its styles, each overridden by the styles <over> gives ("" none), as the pool's style lists say.
function(_zengine_names_palette_types out prefix over)
    set(sizes "")
    foreach(n IN LISTS ${prefix}_sizes)
        list(APPEND sizes "{\"${n}\", ${${prefix}_size_${n}_points}}")
    endforeach()
    string(JOIN ", " sizes_body ${sizes})
    set(styles "")
    foreach(n IN LISTS ${prefix}_styles)
        set(src "${prefix}")
        if(NOT over STREQUAL "" AND n IN_LIST ${over}_styles)
            set(src "${over}")
        endif()
        if(${src}_style_${n}_weight STREQUAL "bold")
            set(weight "::zengine::graphics::text_weight::kBold")
        else()
            set(weight "::zengine::graphics::text_weight::kRegular")
        endif()
        list(APPEND styles "{\"${n}\", \"${${src}_style_${n}_font}\", \"${${src}_style_${n}_size}\", \"${${src}_style_${n}_color}\", ${weight}}")
    endforeach()
    string(JOIN ", " styles_body ${styles})
    set(${out} "    p.sizes = {${sizes_body}};\n    p.styles = {${styles_body}};\n" PARENT_SCOPE)
endfunction()
