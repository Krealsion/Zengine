{
 "format": "zengine-setup",
 "format_version": "1",
 "guide": "README.md",
 "medium": {
  "supports": [
   "sdl",
   "tui"
  ],
  "viewport": [
   120,
   56
  ]
 },
 "authority": {
  "may": [
   "input",
   "capture",
   "inspect",
   "inventory",
   "toolbox",
   "demo",
   "open"
  ]
 },
 "desk": "desk.json",
 "title": "Command presets",
 "summary": "Inventory, Loaded, Info and Compose for partial command presets.",
 "task": "Save an incomplete command as a preset, reopen it and finish it from a typed record.",
 "choose": "you want to try presets and partial commands.",
 "prepares": [
  "nine labelled captures of Input's state shape",
  "Inventory, Loaded, Info, Compose and the Demo controls"
 ],
 "first_task": {
  "do": "Run `workshop/inventory-preset-demo` with a fresh label.",
  "expect": "A blank template, a complete command and an incomplete preset are stored; both editors reset."
 },
 "variations": [
  "Run `workshop/inventory-slots-demo` for portable rows and hotkeys"
 ],
 "limits": [
  "Each slots story adds three portable views, within Inventory's twelve-view bound"
 ],
 "material": {
  "capture": {
   "target_role": "zengine.input",
   "labels": [
    "Demo input 1",
    "Demo input 2",
    "Demo input 3",
    "Demo input 4",
    "Demo input 5",
    "Demo input 6",
    "Demo input 7",
    "Demo input 8",
    "Demo input 9"
   ]
  }
 },
 "reset": {
  "scope": "the layout, the nine Demo input entries' values and labels, Inventory's selection and the Info/Compose drafts on the desk",
  "keeps": "every entry you created, including saved copies and commands; submitted commands are not undone"
 },
 "walks": {
  "escape": {
   "about": "Escape in Inventory, Loaded, Compose, Info and the Demo controls: a selection let go first, then the pane put down",
   "steps": [
    {
     "click": [
      "zengine.inventory-pane",
      "inventory",
      "Demo input 3"
     ]
    },
    {
     "expect": [
      "zengine.inventory-pane",
      "inventory",
      "> Demo input 3"
     ]
    },
    {
     "picture": "inventory-1-chosen"
    },
    {
     "press": "escape"
    },
    {
     "picture": "inventory-2-down"
    },
    {
     "click": [
      "zengine.introspection",
      "loaded",
      "zengine-timer"
     ]
    },
    {
     "expect": [
      "zengine.introspection",
      "loaded",
      "> zengine-timer"
     ]
    },
    {
     "picture": "loaded-1-marked"
    },
    {
     "press": "escape"
    },
    {
     "absent": [
      "zengine.introspection",
      "loaded",
      "> zengine-timer"
     ]
    },
    {
     "picture": "loaded-2-unmarked"
    },
    {
     "press": "escape"
    },
    {
     "picture": "loaded-3-down"
    },
    {
     "click": [
      "zengine.introspection",
      "loaded",
      "zengine-timer"
     ]
    },
    {
     "click": [
      "zengine.composer",
      "compose",
      "StartTimer v1"
     ]
    },
    {
     "expect": [
      "zengine.composer",
      "compose",
      "StartTimer v1 -> @zengine.timer"
     ]
    },
    {
     "picture": "compose-1-form"
    },
    {
     "press": "escape"
    },
    {
     "expect": [
      "zengine.composer",
      "compose",
      "accepted messages"
     ]
    },
    {
     "absent": [
      "zengine.composer",
      "compose",
      "StartTimer v1 -> @zengine.timer"
     ]
    },
    {
     "picture": "compose-2-catalog"
    },
    {
     "press": "escape"
    },
    {
     "picture": "compose-3-down"
    },
    {
     "click": [
      "zengine.info",
      "info",
      "Loaded -- open"
     ]
    },
    {
     "expect": [
      "zengine.info",
      "info",
      "PANE Loaded"
     ]
    },
    {
     "picture": "info-1-chosen"
    },
    {
     "press": "escape"
    },
    {
     "picture": "info-2-down"
    },
    {
     "click": [
      "zengine.demo",
      "controls",
      "Command presets"
     ]
    },
    {
     "picture": "demo-1-chosen"
    },
    {
     "press": "escape"
    },
    {
     "picture": "demo-2-down"
    },
    {
     "click": [
      "zengine.introspection",
      "loaded",
      "zengine-timer"
     ]
    },
    {
     "press": "escape"
    },
    {
     "absent": [
      "zengine.introspection",
      "loaded",
      "> zengine-timer"
     ]
    },
    {
     "press": "escape"
    }
   ]
  }
 }
}
