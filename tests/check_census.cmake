endif()
zen_census_judge_counts("doors|a.hpp|W|4;hooks|a.hpp|H|2;doors|b.hpp|V|1" "${st_rows}" "doors|a.hpp|W|3|falls" st_p st_u)
if(NOT st_p MATCHES "W counts 4 doors, and its row says 3" OR NOT st_p MATCHES "V counts 1 doors, and no row pins it")
    list(APPEND st_failed "a count that moved and one no row pins read as '${st_p}'")
endif()
zen_census_parse("doors a.hpp W 4 falls\n" st)
zen_census_judge_counts("doors|a.hpp|W|4" "${st_COUNTS}" "doors|a.hpp|W|3|falls" st_p st_u)
if(NOT st_p MATCHES "marked to only fall, and it rose from 3 at the base to 4")
    list(APPEND st_failed "a marked count raised against its base read as '${st_p}'")
endif()
zen_census_judge_counts("doors|a.hpp|W|4" "${st_COUNTS}" "-" st_p st_u)
if(st_p)
    list(APPEND st_failed "a marked count the base does not hold read as '${st_p}', want it held from here on")
endif()
zen_census_judge_counts("" "${st_COUNTS}" "-" st_p st_u)
if(NOT st_p MATCHES "the tree counts none: the row goes")
    list(APPEND st_failed "a count row the tree no longer holds read as '${st_p}'")
endif()
# The built-apart law: kind and reach rows read, a path's kind and package, and the table's
# refusals and allowances, each branch once each way.
zen_census_parse("kind w/ host\nkind w/p/ weave\nkind w/v_vocabulary.hpp vocabulary\nkind t/ test\nkind f/ weave\nkind l/ library\nkind w/ library\nkind x/ shape\nreach t/a.cpp w/s.hpp 1 falls\n" st)
list(LENGTH st_PROBLEMS st_np)
if(NOT st_KINDS STREQUAL "w/|host;w/p/|weave;w/v_vocabulary.hpp|vocabulary;t/|test;f/|weave;l/|library;w/|library;x/|shape"
   OR NOT st_REACHES STREQUAL "t/a.cpp|w/s.hpp|1|falls" OR NOT st_np EQUAL 2)
    list(APPEND st_failed "the law's rows read as kinds '${st_KINDS}', reaches '${st_REACHES}' and ${st_np} problem(s), want the second w/ row and the shape refused")
endif()
zen_census_parse("kind w/ host\nkind w/p/ weave\nkind w/v_vocabulary.hpp vocabulary\nkind t/ test\nkind f/ weave\nkind g/ weave\nkind l/ library\n" st)
foreach(st_case "w/x.hpp|host|w/|1" "w/p/x.cpp|weave|w/p/|0" "w/v_vocabulary.hpp|vocabulary|w/|1" "t/x.cpp|test|t/|0" "q/x.cpp||||")
    string(REPLACE "|" ";" st_case "${st_case}")
    list(GET st_case 0 st_path)
    list(GET st_case 1 st_wk)
    list(GET st_case 2 st_wp)
    list(GET st_case 3 st_wh)
    zen_census_kind("${st_path}" "${st_KINDS}" st_k st_p st_h)
    if(NOT st_k STREQUAL st_wk OR NOT st_p STREQUAL st_wp OR (NOT st_wh STREQUAL "" AND NOT st_h EQUAL st_wh))
        list(APPEND st_failed "${st_path} read as kind '${st_k}' in '${st_p}' (host folder ${st_h}), want '${st_wk}' in '${st_wp}'")
    endif()
endforeach()
foreach(st_case "weave f/ host w/ 0 1" "weave f/ weave g/ 0 1" "weave f/ weave f/ 0 0" "weave f/ library l/ 0 0"
                "weave f/ vocabulary w/ 1 1" "host w/ vocabulary w/ 1 0" "weave f/ vocabulary g/ 0 0" "host w/ weave f/ 0 1"
                "host w/ library l/ 0 0" "library l/ host w/ 0 1" "library l/ weave f/ 0 1" "vocabulary g/ library l/ 0 1"
                "vocabulary g/ vocabulary h/ 0 0" "test t/ host w/ 0 1" "test t/ weave f/ 0 1" "test t/ library l/ 0 0"
                "test t/ vocabulary w/ 1 1" "weave f/ loom-host loom 0 1" "weave f/ loom loom 0 0" "test t/ loom-host loom 0 0"
                "host w/ loom-host loom 0 0" "library l/ loom-host loom 0 1")
