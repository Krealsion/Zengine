endif()
# A class's lines are its lines of code: comment lines, a `/* */` block and blanks inside it count
# for nothing, so this class is five lines long as the one above is.
zen_census_counts("class C\n    : public X {\n    // one\n\n    int a; // two\n    /* three\n       four */\n    int b;\n};\n" 2 4 st_counts st_cp)
if(NOT st_counts STREQUAL "lines|C|5" OR st_cp)
    list(APPEND st_failed "a class among comments and a blank read as '${st_counts}' with '${st_cp}', want 'lines|C|5'")
