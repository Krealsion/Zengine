#
# The `census` entry (VM-CHECK-17): every row of tests/census.txt held by the tree, either way,
# and a row marked `falls` never raised against the base (ZEN_BASE, else the merge-base with
# origin/main): the Workshop line (agents/workshop-line.md), what a file grows, and every include
# the built-apart law refuses (docs/architecture/README.md, "Every unit is one of five kinds").
#   cmake -P tests/check_census.cmake                 (from the repository root, or -DZEN_REPO=<repo>)
#   cmake -DZEN_CENSUS_WRITE=<file> -P tests/check_census.cmake   (the census as the tree stands)

cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ZEN_REPO OR ZEN_REPO STREQUAL "")
    set(ZEN_REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
get_filename_component(ZEN_REPO "${ZEN_REPO}" ABSOLUTE)
if(NOT EXISTS "${ZEN_REPO}/AGENTS.md" OR NOT EXISTS "${ZEN_REPO}/tests/census.txt")
    message(FATAL_ERROR "census: '${ZEN_REPO}' is not this repository's root (no AGENTS.md and "
                        "tests/census.txt). Pass -DZEN_REPO=<repository root>.")
endif()

set(ZEN_CENSUS_CODE_KINDS feature host library examples)
set(ZEN_CENSUS_SOURCES *.hpp *.h *.cpp *.c *.hpp.in *.h.in *.cpp.in)
set(ZEN_CENSUS_SIDES workshop zengine)
# The built-apart law's kinds, and the kind each kind of top-level folder (tests/folders.txt) is
# written with when it has no row: a feature is a weave, and an example is a program that hosts its
# weaves, its weaves' folders weaves as a host's are.
set(ZEN_CENSUS_KINDS weave host library vocabulary test)
set(ZEN_CENSUS_KIND_OF_feature weave)
set(ZEN_CENSUS_KIND_OF_examples host)
set(ZEN_CENSUS_KIND_OF_host host)
set(ZEN_CENSUS_KIND_OF_library library)
set(ZEN_CENSUS_KIND_OF_tests test)
# A header is a vocabulary when its name says so: these words in a file's name.
set(ZEN_CENSUS_VOCABULARY_NAMES vocabulary pane_view.hpp setup_control.hpp pane_shortcuts.hpp)
# Loom's host surface, which only a host or a test includes: the kernel but its export header, the
# in-process Switchboard, and zen/host/. Every other Loom header is the weave surface.
set(ZEN_CENSUS_LOOM_HOST "^zen/kernel/" "^zen/switchboard[.]hpp$" "^zen/switchboard/(switchboard|bus|turn)[.]hpp$" "^zen/host/")
set(ZEN_CENSUS_LOOM_WEAVE "^zen/kernel/(export[.]hpp|abi[.]h)$")
# A struct with this many `std::function` members or more is a host's hooks; a class this many
# lines long or more is past the threshold, and its row pins it from there.
set(ZEN_CENSUS_HOOKS_FROM 4)
set(ZEN_CENSUS_CLASS_LINES_FROM 1000)

# ---- the readings, one place each so the self-test exercises the real ones -------------------

# The census's rows: `side <folder> <side>`, `line <file> <header> <count> [falls]`,
# `doors|hooks|lines <file> <name> <count> [falls]`, `kind <folder>/ <kind>` or `kind <file> <kind>`,
# and `reach <file> <header> <count> [falls]`, `#` a comment. Each malformed row is a problem, never a
# row read some other way.
function(zen_census_parse text prefix)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(sides "")
    set(rows "")
    set(counts "")
    set(kinds "")
    set(reaches "")
    set(problems "")
    set(n 0)
    foreach(line IN LISTS lines)
        math(EXPR n "${n} + 1")
        if(line MATCHES "^[ \t]*(#|$)")
            continue()
        elseif(line MATCHES "^side[ \t]+([A-Za-z0-9_./-]+)/[ \t]+([a-z]+)[ \t]*$")
            set(folder "${CMAKE_MATCH_1}")
            set(side "${CMAKE_MATCH_2}")
            if(NOT side IN_LIST ZEN_CENSUS_SIDES)
                list(APPEND problems "census.txt:${n}: a side is `workshop` or `zengine`, not `${side}`")
            else()
                list(APPEND sides "${folder}/|${side}")
            endif()
        elseif(line MATCHES "^line[ \t]+([A-Za-z0-9_./-]+)[ \t]+([A-Za-z0-9_./-]+)[ \t]+([1-9][0-9]*)([ \t]+falls)?[ \t]*$")
            # The captures are copied before the loop below matches again (VM-CHECK-03).
            set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
            set(count "${CMAKE_MATCH_3}")
            set(mark "")
            if(CMAKE_MATCH_4)
                set(mark falls)
            endif()
            foreach(row IN LISTS rows)
                if(row MATCHES "^([^|]+[|][^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL key)
                    list(APPEND problems "census.txt:${n}: a second row for ${key}")
                endif()
            endforeach()
            list(APPEND rows "${key}|${count}|${mark}")
        elseif(line MATCHES "^(doors|hooks|lines)[ \t]+([A-Za-z0-9_./-]+)[ \t]+([A-Za-z_][A-Za-z0-9_.]*)[ \t]+([1-9][0-9]*)([ \t]+falls)?[ \t]*$")
            set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_3}")
            set(count "${CMAKE_MATCH_4}")
            set(mark "")
            if(CMAKE_MATCH_5)
                set(mark falls)
            endif()
            foreach(row IN LISTS counts)
                if(row MATCHES "^([^|]+[|][^|]+[|][^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL key)
                    list(APPEND problems "census.txt:${n}: a second row for ${key}")
                endif()
            endforeach()
            list(APPEND counts "${key}|${count}|${mark}")
        elseif(line MATCHES "^kind[ \t]+([A-Za-z0-9_./-]+)[ \t]+([a-z]+)[ \t]*$")
            set(kpath "${CMAKE_MATCH_1}")
            set(kkind "${CMAKE_MATCH_2}")
            if(NOT kkind IN_LIST ZEN_CENSUS_KINDS)
                string(REPLACE ";" ", " said "${ZEN_CENSUS_KINDS}")
                list(APPEND problems "census.txt:${n}: a kind is one of ${said}, not `${kkind}`")
            endif()
            foreach(row IN LISTS kinds)
                if(row MATCHES "^([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL kpath)
                    list(APPEND problems "census.txt:${n}: a second kind row for ${kpath}")
                endif()
            endforeach()
            list(APPEND kinds "${kpath}|${kkind}")
        elseif(line MATCHES "^reach[ \t]+([A-Za-z0-9_./-]+)[ \t]+([A-Za-z0-9_./-]+)[ \t]+([1-9][0-9]*)([ \t]+falls)?[ \t]*$")
            set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
            set(count "${CMAKE_MATCH_3}")
            set(mark "")
            if(CMAKE_MATCH_4)
                set(mark falls)
            endif()
            foreach(row IN LISTS reaches)
                if(row MATCHES "^([^|]+[|][^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL key)
                    list(APPEND problems "census.txt:${n}: a second reach row for ${key}")
                endif()
            endforeach()
            list(APPEND reaches "${key}|${count}|${mark}")
        else()
            list(APPEND problems "census.txt:${n}: not a row: `${line}` (`side <folder>/ <side>`, `line <file> <header> <count> [falls]`, `doors|hooks|lines <file> <name> <count> [falls]`, `kind <path> <kind>` or `reach <file> <header> <count> [falls]`)")
        endif()
    endforeach()
    set(${prefix}_SIDES "${sides}" PARENT_SCOPE)
    set(${prefix}_ROWS "${rows}" PARENT_SCOPE)
    set(${prefix}_COUNTS "${counts}" PARENT_SCOPE)
    set(${prefix}_KINDS "${kinds}" PARENT_SCOPE)
    set(${prefix}_REACHES "${reaches}" PARENT_SCOPE)
    set(${prefix}_PROBLEMS "${problems}" PARENT_SCOPE)
endfunction()

# What a file grows, comments stripped, as `<kind>|<name>|<count>`: `doors`, each Accept list's
# shapes under the nearest class, struct or alias before it (`<name>.2` for a second; a pack is no
# weave's); `hooks`, a struct's `std::function` members, from `hooks_from` on; `lines`, a class's
# lines of code, head to its first `};`, from `lines_from` on, and for a class a `lines` row already
# pins whatever its count (ZEN_CENSUS_PINNED_LINES, `<file>|<class>`, the file being
# ZEN_CENSUS_COUNTING), so a pinned class stays held: a line that holds
# only a comment, or nothing, is none, so a comment never pushes a class past its row. A list
# holding a `<` is not read, and said.
# The forms each reading takes are VM-CHECK-17's (agents/verification/checks.md).
function(zen_census_counts text hooks_from lines_from out out_problems)
    string(REPLACE "\r" "" text "${text}")
    # Every `//` comment goes to its line's end, and then each `/* */` comment whole, its line breaks
    # kept: in that order a `/*` written inside a `//` comment opens nothing.
    string(REGEX REPLACE "//[^\n]*" "" text "${text}")
    set(kept "")
    while(TRUE)
        string(FIND "${text}" "/*" open)
        if(open EQUAL -1)
            break()
        endif()
        string(SUBSTRING "${text}" 0 ${open} before)
        math(EXPR inner "${open} + 2")
        string(SUBSTRING "${text}" ${inner} -1 rest)
        string(FIND "${rest}" "*/" close)
        if(close EQUAL -1)
            set(comment "${rest}")
            set(text "")
        else()
            string(SUBSTRING "${rest}" 0 ${close} comment)
            math(EXPR after "${close} + 2")
            string(SUBSTRING "${rest}" ${after} -1 text)
        endif()
        string(REGEX REPLACE "[^\n]" "" breaks "${comment}")
        string(APPEND kept "${before}${breaks}")
    endwhile()
    string(APPEND kept "${text}")
    set(text "${kept}")
    # A semicolon is a list separator here: each is read as the one character code never holds.
    string(ASCII 1 semi)
    string(REPLACE ";" "${semi}" text "${text}")
    set(found "")
    set(problems "")
    set(names_taken "")
    set(rest "${text}")
    set(done 0)
    while(TRUE)
        string(FIND "${rest}" "loom::Accept<" at)
        if(at EQUAL -1)
            break()
        endif()
        math(EXPR at "${done} + ${at}")
        string(SUBSTRING "${text}" 0 ${at} near)
        string(SUBSTRING "${text}" ${at} -1 from)
        string(REGEX MATCHALL "\n[ \t]*(class|struct)[ \t]+[A-Za-z_][A-Za-z0-9_]*|\n[ \t]*using[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=" names "\n${near}")
        set(name "")
        foreach(candidate IN LISTS names)
            string(REGEX REPLACE "^[ \t\n]*(class|struct|using)[ \t]+([A-Za-z_][A-Za-z0-9_]*).*$" "\\2" candidate "${candidate}")
            if(NOT candidate MATCHES "^(Accepts?|type)$")
                set(name "${candidate}")
            endif()
        endforeach()
        if(from MATCHES "^loom::Accept<([^<>]*)>")
            string(REGEX REPLACE "[ \t\n]" "" inner "${CMAKE_MATCH_1}")
            if(name STREQUAL "")
                list(APPEND problems "an Accept list names no class, struct or alias before it")
            elseif(NOT inner STREQUAL "" AND NOT inner MATCHES "[.][.][.]")
                set(seen 1)
                set(named "${name}")
                while("doors|${named}|" IN_LIST names_taken)
                    math(EXPR seen "${seen} + 1")
                    set(named "${name}.${seen}")
                endwhile()
                list(APPEND names_taken "doors|${named}|")
                set(name "${named}")
                string(REGEX MATCHALL "," commas "${inner}")
                list(LENGTH commas n)
                math(EXPR n "${n} + 1")
                list(APPEND found "doors|${name}|${n}")
            endif()
        else()
            list(APPEND problems "the Accept list of ${name} holds a template argument, which this check does not read")
        endif()
        math(EXPR done "${at} + 13")
        string(SUBSTRING "${text}" ${done} -1 rest)
    endwhile()
    set(rest "\n${text}")
    while(TRUE)
        string(REGEX MATCH "\n(class|struct)[ \t]+([A-Za-z_][A-Za-z0-9_]*)[^${semi}\n]*\n" head "${rest}")
        if(head STREQUAL "")
            break()
        endif()
        set(name "${CMAKE_MATCH_2}")
        string(FIND "${rest}" "${head}" at)
        string(LENGTH "${head}" hlen)
        math(EXPR body_at "${at} + ${hlen}")
        string(SUBSTRING "${rest}" ${body_at} -1 after)
        string(FIND "${after}" "\n}${semi}" end)
        if(end EQUAL -1)
            break()
        endif()
        string(SUBSTRING "${after}" 0 ${end} body)
        # The head's line and the `};` line, and each line of the body that holds code; a bracket is
        # swapped out first, since one would join list items.
        string(REGEX REPLACE "[][\\]" "x" plain "${body}")
        string(REGEX MATCHALL "\n[ \t]*[^ \t\n]" code "\n${plain}")
        list(LENGTH code n)
        math(EXPR n "${n} + 2")
        if(n GREATER_EQUAL lines_from OR "${ZEN_CENSUS_COUNTING}|${name}" IN_LIST ZEN_CENSUS_PINNED_LINES)
            list(APPEND found "lines|${name}|${n}")
        endif()
        string(REGEX MATCHALL "(^|\n)[ \t]*std::function<[^${semi}]*>[ \t\n]+[A-Za-z_][A-Za-z0-9_]*[ \t\n]*(=[^${semi}]*)?${semi}" hooks "${body}")
        list(LENGTH hooks h)
        if(h GREATER_EQUAL hooks_from)
            list(APPEND found "hooks|${name}|${h}")
        endif()
        math(EXPR next "${end} + 3")
        string(SUBSTRING "${after}" ${next} -1 rest)
        set(rest "\n${rest}")
    endwhile()
    set(${out} "${found}" PARENT_SCOPE)
    set(${out_problems} "${problems}" PARENT_SCOPE)
endfunction()

# The judgement of the counted rows: `found` a list of `<kind>|<file>|<name>|<count>`, `rows` the
# census's, `base` the rows at the base (`-` when there is none to read). A marked row is held to
# its row at the base, and one the base does not hold is held from this change on.
function(zen_census_judge_counts found rows base out_problems out_unmarked)
    set(problems "")
    set(unmarked 0)
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 kind)
        list(GET fp 1 file)
        list(GET fp 2 name)
        list(GET fp 3 count)
        set(pinned "")
        foreach(r IN LISTS rows)
            string(REPLACE "|" ";" rp "${r}")
            list(GET rp 0 rk)
            list(GET rp 1 rf)
            list(GET rp 2 rn)
            if(rk STREQUAL kind AND rf STREQUAL file AND rn STREQUAL name)
                list(GET rp 3 pinned)
            endif()
        endforeach()
        if(pinned STREQUAL "")
            list(APPEND problems "${file}'s ${name} counts ${count} ${kind}, and no row pins it")
        elseif(NOT pinned EQUAL count)
            list(APPEND problems "${file}'s ${name} counts ${count} ${kind}, and its row says ${pinned}: the row is set to what the tree holds")
        endif()
    endforeach()
    foreach(r IN LISTS rows)
        string(REPLACE "|" ";" rp "${r}")
        list(GET rp 0 rk)
        list(GET rp 1 rf)
        list(GET rp 2 rn)
        list(GET rp 3 rcount)
        list(LENGTH rp rlen)
        set(rmark "")
        if(rlen GREATER 4)
            list(GET rp 4 rmark)
        endif()
        set(held 0)
        foreach(f IN LISTS found)
            if(f MATCHES "^([^|]+)[|]([^|]+)[|]([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL rk AND
               CMAKE_MATCH_2 STREQUAL rf AND CMAKE_MATCH_3 STREQUAL rn)
                set(held 1)
            endif()
        endforeach()
        if(NOT held)
            list(APPEND problems "the ${rk} row for ${rf}'s ${rn} pins ${rcount}, and the tree counts none: the row goes")
        endif()
        if(NOT rmark STREQUAL "falls")
            math(EXPR unmarked "${unmarked} + 1")
        elseif(NOT base STREQUAL "-")
            foreach(b IN LISTS base)
                string(REPLACE "|" ";" bp "${b}")
                list(GET bp 0 bk)
                list(GET bp 1 bf)
                list(GET bp 2 bn)
                list(GET bp 3 was)
                if(bk STREQUAL rk AND bf STREQUAL rf AND bn STREQUAL rn AND rcount GREATER was)
                    list(APPEND problems "the ${rk} row for ${rf}'s ${rn} is marked to only fall, and it rose from ${was} at the base to ${rcount}")
                endif()
            endforeach()
        endif()
    endforeach()
    set(${out_problems} "${problems}" PARENT_SCOPE)
    set(${out_unmarked} ${unmarked} PARENT_SCOPE)
endfunction()

# The headers the install file names, comments stripped: every token ending `.hpp` or `.h`.
function(zen_census_installed text out)
    string(REPLACE "\r" "" text "${text}")
    string(REGEX REPLACE "#[^\n]*" "" text "${text}")
    string(REGEX MATCHALL "[A-Za-z0-9_./-]+[.]hp?p?[ \t\n)\"]" tokens "${text}")
    set(found "")
    foreach(token IN LISTS tokens)
        string(REGEX REPLACE ".$" "" token "${token}")
        if(token MATCHES "[.](hpp|h)$" AND NOT token MATCHES "^[.]")
            list(APPEND found "${token}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES found)
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# The quoted includes of one source's text, a directive at the start of its line: a `#include`
# inside a comment or after code is not one.
function(zen_census_includes text out)
    string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*\"[^\"\n]+\"" directives "${text}")
    set(found "")
    foreach(d IN LISTS directives)
        string(REGEX REPLACE "^.*\"([^\"]+)\"$" "\\1" d "${d}")
        list(APPEND found "${d}")
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# Which side a repository path is on: the longest `side` row that holds it, else Zengine's; and a
# file the package installs is the package's, whichever folder holds it.
function(zen_census_side path sides installed out)
    set(best "")
    set(best_len -1)
    foreach(row IN LISTS sides)
        string(REPLACE "|" ";" parts "${row}")
        list(GET parts 0 folder)
        list(GET parts 1 side)
        string(LENGTH "${folder}" len)
        string(SUBSTRING "${path}" 0 ${len} head)
        if(head STREQUAL folder AND len GREATER best_len)
            set(best "${side}")
            set(best_len ${len})
        endif()
    endforeach()
    if(best STREQUAL "" OR path IN_LIST installed)
        set(best zengine)
    endif()
    set(${out} "${best}" PARENT_SCOPE)
endfunction()

# The judgement: `found` is a list of `<file>|<header>|<count>`, `rows` the census's, `base` the
# rows at the base (`-` when there is none to read). Its problems name each line to look at, the
# reach's words ZEN_CENSUS_REACH_WORDS (the Workshop line's by default).
function(zen_census_judge found rows base out_problems out_unmarked)
    set(words "across the line")
    if(DEFINED ZEN_CENSUS_REACH_WORDS)
        set(words "${ZEN_CENSUS_REACH_WORDS}")
    endif()
    set(problems "")
    set(unmarked 0)
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 file)
        list(GET fp 1 header)
        list(GET fp 2 count)
        set(pinned "")
        foreach(r IN LISTS rows)
            string(REPLACE "|" ";" rp "${r}")
            list(GET rp 0 rfile)
            list(GET rp 1 rheader)
            if(rfile STREQUAL file AND rheader STREQUAL header)
                list(GET rp 2 pinned)
            endif()
        endforeach()
        if(pinned STREQUAL "")
            list(APPEND problems "${file} includes ${header} ${words} ${count} time(s), and no row pins it")
        elseif(NOT pinned EQUAL count)
            list(APPEND problems "${file} includes ${header} ${words} ${count} time(s), and its row says ${pinned}: the row is set to what the tree holds")
        endif()
    endforeach()
    foreach(r IN LISTS rows)
        string(REPLACE "|" ";" rp "${r}")
        list(GET rp 0 rfile)
        list(GET rp 1 rheader)
        list(GET rp 2 rcount)
        list(LENGTH rp rn)
        set(rmark "")
        if(rn GREATER 3)
            list(GET rp 3 rmark)
        endif()
        set(held 0)
        foreach(f IN LISTS found)
            if(f MATCHES "^([^|]+)[|]([^|]+)[|]")
                if(CMAKE_MATCH_1 STREQUAL rfile AND CMAKE_MATCH_2 STREQUAL rheader)
                    set(held 1)
                endif()
            endif()
        endforeach()
        if(NOT held)
            list(APPEND problems "the row for ${rfile} including ${rheader} pins ${rcount}, and the tree holds none: the row goes")
        endif()
        if(NOT rmark STREQUAL "falls")
            math(EXPR unmarked "${unmarked} + 1")
        elseif(NOT base STREQUAL "-")
            set(was 0)
            foreach(b IN LISTS base)
                string(REPLACE "|" ";" bp "${b}")
                list(GET bp 0 bfile)
                list(GET bp 1 bheader)
                if(bfile STREQUAL rfile AND bheader STREQUAL rheader)
                    list(GET bp 2 was)
                endif()
            endforeach()
            if(rcount GREATER was)
                list(APPEND problems "the row for ${rfile} including ${rheader} is marked to only fall, and it rose from ${was} at the base to ${rcount}")
            endif()
        endif()
    endforeach()
    set(${out_problems} "${problems}" PARENT_SCOPE)
    set(${out_unmarked} ${unmarked} PARENT_SCOPE)
endfunction()

# The Loom headers one source's text includes, `<zen/...>` spelled at the start of its line.
function(zen_census_loom_includes text out)
    string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*<zen/[^>\n]+>" directives "${text}")
    set(found "")
    foreach(d IN LISTS directives)
        string(REGEX REPLACE "^.*<([^>]+)>$" "\\1" d "${d}")
        list(APPEND found "${d}")
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# A repository path's kind and package under the built-apart law: the longest `kind` row that
# holds it, a file's own row before any folder's; its package is the folder of the longest folder
# row that holds it, and `host_folder` says whether that folder is a host's. Nothing when no row
# holds the path.
function(zen_census_kind path kinds out_kind out_package out_host_folder)
    set(kind "")
    set(package "")
    set(folder_kind "")
    set(best -1)
    foreach(row IN LISTS kinds)
        string(REPLACE "|" ";" parts "${row}")
        list(GET parts 0 kpath)
        list(GET parts 1 kkind)
        if(kpath STREQUAL path)
            set(kind "${kkind}")
        elseif(kpath MATCHES "/$")
            string(LENGTH "${kpath}" len)
            string(SUBSTRING "${path}" 0 ${len} head)
            if(head STREQUAL kpath AND len GREATER best)
                set(package "${kpath}")
                set(folder_kind "${kkind}")
                set(best ${len})
            endif()
        endif()
    endforeach()
    if(kind STREQUAL "")
        set(kind "${folder_kind}")
    endif()
    set(${out_kind} "${kind}" PARENT_SCOPE)
    set(${out_package} "${package}" PARENT_SCOPE)
    if(folder_kind STREQUAL "host")
        set(${out_host_folder} 1 PARENT_SCOPE)
    else()
        set(${out_host_folder} 0 PARENT_SCOPE)
    endif()
endfunction()

# Whether the built-apart law refuses an include: a unit of kind `fk` in package `fp` including a
# header of kind `hk` in package `hp`, `hhost` 1 when that header stands in a host's folder; `hk` is
# `loom-host` or `loom` for a Loom header of either surface. The law's table, one branch a row:
#   a weave includes its own package, vocabularies, libraries and Loom's weave surface;
#   a host what a weave may, Loom's host surface, and its own host's folders, never a weave's code;
#   a library libraries, vocabularies and Loom's weave surface;
#   a vocabulary vocabularies and Loom's weave surface, and stands in the folder of its contract,
#     never a host's: a vocabulary in a host's folder is refused to everyone but its host;
#   a test what a host may, and its own helpers, never a weave's or a host's implementation.
function(zen_census_refused fk fp hk hp hhost out)
    set(no 0)
    if(fp STREQUAL hp)
    elseif(hk STREQUAL "loom-host")
        if(fk MATCHES "^(weave|library|vocabulary)$")
            set(no 1)
        endif()
    elseif(hk STREQUAL "loom")
    elseif(hk STREQUAL "vocabulary")
        if(hhost AND NOT fk STREQUAL "host")
            set(no 1)
        endif()
    elseif(fk STREQUAL "vocabulary")
        set(no 1)
    elseif(fk MATCHES "^(weave|library|test)$" AND hk MATCHES "^(weave|host)$")
        set(no 1)
    elseif(fk STREQUAL "host" AND hk STREQUAL "weave")
        set(no 1)
    endif()
    set(${out} ${no} PARENT_SCOPE)
endfunction()

# ---- the self-test: make it say NO, and make it say YES (VM-CHECK-01) ----------------------------

set(st_failed "")
zen_census_includes("#include \"a/b.hpp\"\n// #include \"c/d.hpp\"\n  #  include \"e/f.h\" // x\nint x; #include \"g.hpp\"\n#include <h/i.hpp>\n" st_inc)
if(NOT st_inc STREQUAL "a/b.hpp;e/f.h")
    list(APPEND st_failed "the includes read as '${st_inc}', want 'a/b.hpp;e/f.h'")
endif()
zen_census_installed("set(x a/b.hpp\n    c/d.h)  # e/f.hpp\ninstall(FILES g/h.hpp DESTINATION y)\n" st_inst)
if(NOT st_inst STREQUAL "a/b.hpp;c/d.h;g/h.hpp")
    list(APPEND st_failed "the installed headers read as '${st_inst}', want 'a/b.hpp;c/d.h;g/h.hpp'")
endif()
zen_census_parse("# c\nside w/ workshop\nside w/m/ zengine\nline a/b.hpp w/c.hpp 2 falls\nline a/d.hpp w/c.hpp 1\nbad row\n" st)
list(LENGTH st_PROBLEMS st_np)
if(NOT st_SIDES STREQUAL "w/|workshop;w/m/|zengine" OR NOT st_ROWS STREQUAL "a/b.hpp|w/c.hpp|2|falls;a/d.hpp|w/c.hpp|1|"
   OR NOT st_np EQUAL 1)
    list(APPEND st_failed "the census read as sides '${st_SIDES}', rows '${st_ROWS}' and ${st_np} problem(s), want two sides, two rows and the bad row")
