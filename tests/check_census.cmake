zen_census_parse("doors a.hpp W 3 falls\nhooks a.hpp H 2\n" st)
set(st_rows "${st_COUNTS}")
zen_census_judge_counts("doors|a.hpp|W|3;hooks|a.hpp|H|2" "${st_rows}" "doors|a.hpp|W|3|falls" st_p st_u)
if(st_p OR NOT st_u EQUAL 1)
