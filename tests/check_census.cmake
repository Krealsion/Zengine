endforeach()
zen_census_loom_includes("#include <zen/weave.hpp>\n// #include <zen/host/x.hpp>\n#include <vector>\n #include \"zen/q.hpp\"\n" st_inc)
if(NOT st_inc STREQUAL "zen/weave.hpp")
    list(APPEND st_failed "the Loom includes read as '${st_inc}', want 'zen/weave.hpp'")
