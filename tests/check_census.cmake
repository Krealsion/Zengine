# ---- the census, the package's headers and the base ------------------------------------------

file(READ "${ZEN_REPO}/tests/census.txt" census_text)
zen_census_parse("${census_text}" census)
set(problems ${census_PROBLEMS})
if(census_SIDES STREQUAL "")
    list(APPEND problems "tests/census.txt names no side: every file would be Zengine's and nothing would cross")
endif()

file(READ "${ZEN_REPO}/cmake/ZengineInstall.cmake" install_text)
zen_census_installed("${install_text}" installed)
foreach(h IN LISTS installed)
    if(NOT EXISTS "${ZEN_REPO}/${h}")
        list(APPEND problems "cmake/ZengineInstall.cmake names ${h}, which is no file of the tree: the package's headers are misread")
    endif()
endforeach()
if(NOT "pane/vocabulary.hpp" IN_LIST installed)
    list(APPEND problems "the package's headers read from cmake/ZengineInstall.cmake hold no pane/vocabulary.hpp: they are misread")
endif()

# The base: what the marked rows are held to. With no Git, no base or no census at it, nothing
# is held and the check says so.
set(base_rows "-")
set(base_counts "-")
set(base_reaches "-")
set(base_said "no base was read")
find_program(ZEN_CENSUS_GIT git)
if(ZEN_CENSUS_GIT)
    if(NOT DEFINED ZEN_BASE OR ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" merge-base HEAD origin/main
                        RESULT_VARIABLE rc OUTPUT_VARIABLE ZEN_BASE ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT rc EQUAL 0)
            set(ZEN_BASE "")
            set(base_said "no base was read: `git merge-base HEAD origin/main` failed, so no marked row is held to one (ZEN_BASE names one)")
        endif()
    endif()
    if(NOT ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" show "${ZEN_BASE}:tests/census.txt"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE base_text ERROR_QUIET)
        if(rc EQUAL 0)
            zen_census_parse("${base_text}" base)
            set(base_rows "${base_ROWS}")
            set(base_counts "${base_COUNTS}")
            # A base that holds no reach row is from before the law's rows: none is held to it.
            if(NOT base_REACHES STREQUAL "")
                set(base_reaches "${base_REACHES}")
            endif()
            set(base_said "marked rows held to the base ${ZEN_BASE}")
        else()
            set(base_said "the base ${ZEN_BASE} holds no tests/census.txt, so no marked row is held to one")
        endif()
    endif()
else()
    set(base_said "no base was read: no git was found, so no marked row is held to one")
endif()

# ---- the tree --------------------------------------------------------------------------------

file(STRINGS "${ZEN_REPO}/tests/folders.txt" folder_rows REGEX "^[^#]")
set(roots "")
foreach(row IN LISTS folder_rows)
    if(row MATCHES "^([^ \t]+)[ \t]+([a-z]+)[ \t]*$" AND CMAKE_MATCH_2 IN_LIST ZEN_CENSUS_CODE_KINDS)
        list(APPEND roots "${CMAKE_MATCH_1}")
    endif()
endforeach()
set(sources "")
foreach(root IN LISTS roots)
    set(globs "")
    foreach(pattern IN LISTS ZEN_CENSUS_SOURCES)
        list(APPEND globs "${ZEN_REPO}/${root}/${pattern}")
    endforeach()
    file(GLOB_RECURSE found_here RELATIVE "${ZEN_REPO}" ${globs})
    list(APPEND sources ${found_here})
endforeach()
list(LENGTH sources source_count)
if(source_count EQUAL 0)
    message(FATAL_ERROR "census: no source was found under the code folders of tests/folders.txt; an empty tree would pass")
endif()

set(found "")
set(counted "")
set(counted_keys "")
set(where "")
set(workshop_files 0)
set(toward_workshop 0)
set(toward_zengine 0)
set(ZEN_CENSUS_PINNED_LINES "")
foreach(r IN LISTS census_COUNTS)
    if(r MATCHES "^lines[|]([^|]+[|][^|]+)[|]")
        list(APPEND ZEN_CENSUS_PINNED_LINES "${CMAKE_MATCH_1}")
    endif()
endforeach()
foreach(src IN LISTS sources)
    zen_census_side("${src}" "${census_SIDES}" "${installed}" from)
    if(from STREQUAL "workshop")
        math(EXPR workshop_files "${workshop_files} + 1")
    endif()
    file(READ "${ZEN_REPO}/${src}" text)
    set(ZEN_CENSUS_COUNTING "${src}")
    zen_census_counts("${text}" ${ZEN_CENSUS_HOOKS_FROM} ${ZEN_CENSUS_CLASS_LINES_FROM} grown grown_problems)
    foreach(g IN LISTS grown)
        string(REPLACE "|" ";" gp "${g}")
        list(GET gp 0 gk)
        list(GET gp 1 gn)
        list(GET gp 2 gc)
        if("${gk}|${src}|${gn}" IN_LIST counted_keys)
            list(APPEND problems "${src} has a second ${gk} count named ${gn}: a row is keyed by its file and name")
        endif()
        list(APPEND counted_keys "${gk}|${src}|${gn}")
        list(APPEND counted "${gk}|${src}|${gn}|${gc}")
    endforeach()
    foreach(p IN LISTS grown_problems)
        list(APPEND problems "${src}: ${p}")
    endforeach()
    zen_census_includes("${text}" heads)
    if(heads STREQUAL "")
        continue()
    endif()
    get_filename_component(dir "${src}" DIRECTORY)
    set(here "")
    foreach(h IN LISTS heads)
        if(EXISTS "${ZEN_REPO}/${dir}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${dir}/${h}")
            get_filename_component(abs "${ZEN_REPO}/${dir}/${h}" ABSOLUTE)
            file(RELATIVE_PATH target "${ZEN_REPO}" "${abs}")
        elseif(EXISTS "${ZEN_REPO}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${h}")
            set(target "${h}")
        else()
            continue()
        endif()
        zen_census_side("${target}" "${census_SIDES}" "${installed}" to)
        if(from STREQUAL to)
            continue()
        endif()
        if(from STREQUAL "workshop" AND target IN_LIST installed)
            continue()
        endif()
        list(APPEND here "${target}")
        if(to STREQUAL "workshop")
            math(EXPR toward_workshop "${toward_workshop} + 1")
        else()
            math(EXPR toward_zengine "${toward_zengine} + 1")
        endif()
        # The line of the file it stands on, for the problem that names it.
        string(REGEX MATCH "(^|\n)[ \t]*#[ \t]*include[ \t]*\"${h}\"" hit "${text}")
        string(FIND "${text}" "${hit}" at)
        string(SUBSTRING "${text}" 0 ${at} before)
        string(REGEX MATCHALL "\n" breaks "${before}")
        list(LENGTH breaks n)
        if(hit MATCHES "^\n")
            math(EXPR n "${n} + 2")
        else()
            math(EXPR n "${n} + 1")
        endif()
        list(APPEND where "${src}|${target}|${src}:${n}")
    endforeach()
    list(REMOVE_DUPLICATES here)
    foreach(target IN LISTS here)
        set(count 0)
        foreach(w IN LISTS where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL src AND CMAKE_MATCH_2 STREQUAL target)
                math(EXPR count "${count} + 1")
            endif()
        endforeach()
        list(APPEND found "${src}|${target}|${count}")
    endforeach()
endforeach()
if(workshop_files EQUAL 0)
    message(FATAL_ERROR "census: no source is on Workshop's side; the side rows of tests/census.txt hold nothing, and nothing could cross")
endif()

# ---- the tree read against the built-apart law ---------------------------------------------------
# Every source of the code folders and of tests/ (its third-party code apart) given its kind by the
# kind rows, and each include the law refuses, a first-party header found beside the file or from
# the repository's root, or a Loom header of its host surface. A package of the tree with no kind
# row that decides it is a problem, as a kind row naming no path is; the writer proposes one.
set(law_roots ${roots} tests)
set(law_sources "")
foreach(root IN LISTS law_roots)
    set(globs "")
    foreach(pattern IN LISTS ZEN_CENSUS_SOURCES)
        list(APPEND globs "${ZEN_REPO}/${root}/${pattern}")
    endforeach()
    file(GLOB_RECURSE found_here RELATIVE "${ZEN_REPO}" ${globs})
    list(FILTER found_here EXCLUDE REGEX "^tests/third_party/")
    list(APPEND law_sources ${found_here})
endforeach()
list(LENGTH law_sources law_source_count)
foreach(row IN LISTS census_KINDS)
    if(row MATCHES "^([^|]+)[|]" AND NOT EXISTS "${ZEN_REPO}/${CMAKE_MATCH_1}")
        list(APPEND problems "the kind row for ${CMAKE_MATCH_1} names no path of the tree: the row goes")
    endif()
endforeach()
# The packages a kind row decides: each top-level code folder and tests/, and under a host's folder
# each folder whose CMakeLists.txt builds a weave or a provider; each vocabulary by its name.
set(law_proposed "")
foreach(root IN LISTS law_roots)
    set(kind_of "")
    foreach(row IN LISTS folder_rows)
        if(row MATCHES "^([^ \t]+)[ \t]+([a-z]+)[ \t]*$" AND CMAKE_MATCH_1 STREQUAL root)
            set(kind_of "${ZEN_CENSUS_KIND_OF_${CMAKE_MATCH_2}}")
        endif()
    endforeach()
    list(APPEND law_proposed "${root}/|${kind_of}")
    if(kind_of STREQUAL "host")
        file(GLOB_RECURSE lists RELATIVE "${ZEN_REPO}" "${ZEN_REPO}/${root}/*/CMakeLists.txt")
        foreach(l IN LISTS lists)
            file(READ "${ZEN_REPO}/${l}" ltext)
            if(ltext MATCHES "zengine_weave[(]|zengine_provider[(]")
                get_filename_component(ldir "${l}" DIRECTORY)
                list(APPEND law_proposed "${ldir}/|weave")
            endif()
        endforeach()
    endif()
endforeach()
foreach(src IN LISTS law_sources)
    if(src MATCHES "^tests/")
        continue()
    endif()
    get_filename_component(name "${src}" NAME)
    foreach(word IN LISTS ZEN_CENSUS_VOCABULARY_NAMES)
        string(FIND "${name}" "${word}" at)
        if(NOT at EQUAL -1 AND src MATCHES "[.]h(pp)?$")
            list(APPEND law_proposed "${src}|vocabulary")
            break()
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES law_proposed)
set(law_kinds "${census_KINDS}")
foreach(prop IN LISTS law_proposed)
    string(REPLACE "|" ";" pp "${prop}")
    list(GET pp 0 ppath)
    set(held 0)
    foreach(row IN LISTS census_KINDS)
        if(row MATCHES "^([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL ppath)
            set(held 1)
        endif()
    endforeach()
    if(NOT held)
        list(APPEND law_kinds "${prop}")
        list(APPEND problems "${ppath} has no kind row: `kind ${ppath} <kind>` (the writer proposes `${prop}`)")
    endif()
endforeach()
set(law_found "")
set(law_where "")
set(law_edges 0)
foreach(src IN LISTS law_sources)
    zen_census_kind("${src}" "${law_kinds}" fk fp fh)
    file(READ "${ZEN_REPO}/${src}" text)
    zen_census_includes("${text}" heads)
    zen_census_loom_includes("${text}" louts)
    get_filename_component(dir "${src}" DIRECTORY)
    set(here "")
    foreach(h IN LISTS heads louts)
        if(h IN_LIST louts AND h MATCHES "^zen/")
            set(target "${h}")
            set(hk loom)
            set(hp loom)
            set(hh 0)
            foreach(pat IN LISTS ZEN_CENSUS_LOOM_HOST)
                if(target MATCHES "${pat}" AND NOT target MATCHES "${ZEN_CENSUS_LOOM_WEAVE}")
                    set(hk loom-host)
                endif()
            endforeach()
        else()
            if(EXISTS "${ZEN_REPO}/${dir}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${dir}/${h}")
                get_filename_component(abs "${ZEN_REPO}/${dir}/${h}" ABSOLUTE)
                file(RELATIVE_PATH target "${ZEN_REPO}" "${abs}")
            elseif(EXISTS "${ZEN_REPO}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${h}")
                set(target "${h}")
            else()
                continue()
            endif()
            if(target MATCHES "^tests/third_party/")
                continue()
            endif()
            zen_census_kind("${target}" "${law_kinds}" hk hp hh)
        endif()
        zen_census_refused("${fk}" "${fp}" "${hk}" "${hp}" ${hh} refused)
        if(NOT refused)
            continue()
        endif()
        list(APPEND here "${target}")
        math(EXPR law_edges "${law_edges} + 1")
        string(REGEX MATCH "(^|\n)[ \t]*#[ \t]*include[ \t]*[\"<]${h}[\">]" hit "${text}")
        string(FIND "${text}" "${hit}" at)
        string(SUBSTRING "${text}" 0 ${at} before)
        string(REGEX MATCHALL "\n" breaks "${before}")
        list(LENGTH breaks n)
        if(hit MATCHES "^\n")
            math(EXPR n "${n} + 2")
        else()
            math(EXPR n "${n} + 1")
        endif()
        list(APPEND law_where "${src}|${target}|${src}:${n}")
    endforeach()
    list(REMOVE_DUPLICATES here)
    foreach(target IN LISTS here)
        set(count 0)
        foreach(w IN LISTS law_where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL src AND CMAKE_MATCH_2 STREQUAL target)
                math(EXPR count "${count} + 1")
            endif()
        endforeach()
        list(APPEND law_found "${src}|${target}|${count}")
    endforeach()
endforeach()

# ---- write mode: the census as the tree stands ------------------------------------------------

if(DEFINED ZEN_CENSUS_WRITE)
    set(out "")
    string(REPLACE "\r" "" census_text_lf "${census_text}")
    string(REGEX MATCH "^(#[^\n]*\n)+" head "${census_text_lf}")
    string(APPEND out "${head}\n")
    foreach(s IN LISTS census_SIDES)
        string(REPLACE "|" " " s "${s}")
        string(APPEND out "side ${s}\n")
    endforeach()
    string(APPEND out "\n")
    list(SORT found)
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 file)
        list(GET fp 1 header)
        list(GET fp 2 count)
        set(mark " falls")
        foreach(r IN LISTS census_ROWS)
            if(r MATCHES "^([^|]+)[|]([^|]+)[|][0-9]+[|]$" AND CMAKE_MATCH_1 STREQUAL file AND CMAKE_MATCH_2 STREQUAL header)
                set(mark "")
            endif()
        endforeach()
        string(APPEND out "line ${file} ${header} ${count}${mark}\n")
    endforeach()
    # The counted rows, a block a kind; a row keeps its mark, and a new one is written unmarked.
    foreach(kind doors hooks lines)
        set(block "")
        foreach(c IN LISTS counted)
            string(REPLACE "|" ";" cp "${c}")
            list(GET cp 0 ck)
            if(NOT ck STREQUAL kind)
                continue()
            endif()
            list(GET cp 1 cf)
            list(GET cp 2 cn)
            list(GET cp 3 cc)
            set(mark "")
            foreach(r IN LISTS census_COUNTS)
                if(r STREQUAL "${kind}|${cf}|${cn}|${cc}|falls" OR r MATCHES "^${kind}[|]${cf}[|]${cn}[|][0-9]+[|]falls$")
                    set(mark " falls")
                endif()
            endforeach()
            list(APPEND block "${kind} ${cf} ${cn} ${cc}${mark}")
        endforeach()
        list(SORT block)
        if(block)
            string(APPEND out "\n")
            foreach(b IN LISTS block)
                string(APPEND out "${b}\n")
            endforeach()
        endif()
    endforeach()
    # The built-apart law: a kind row a package, then a reach row a refused include, a new one
    # marked to fall; a row keeps its mark.
    string(APPEND out "\n")
    set(block "")
    foreach(k IN LISTS law_kinds)
        string(REPLACE "|" " " k "${k}")
        list(APPEND block "kind ${k}")
    endforeach()
    list(SORT block)
    foreach(b IN LISTS block)
        string(APPEND out "${b}\n")
    endforeach()
    string(APPEND out "\n")
    list(SORT law_found)
    foreach(f IN LISTS law_found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 file)
        list(GET fp 1 header)
        list(GET fp 2 count)
        set(mark " falls")
        foreach(r IN LISTS census_REACHES)
            if(r MATCHES "^([^|]+)[|]([^|]+)[|][0-9]+[|]$" AND CMAKE_MATCH_1 STREQUAL file AND CMAKE_MATCH_2 STREQUAL header)
                set(mark "")
            endif()
        endforeach()
        string(APPEND out "reach ${file} ${header} ${count}${mark}\n")
    endforeach()
    # LF on every host, as the census is committed.
    file(CONFIGURE OUTPUT "${ZEN_CENSUS_WRITE}" CONTENT "${out}" @ONLY NEWLINE_STYLE UNIX)
    message(STATUS "census: wrote the census as the tree stands to ${ZEN_CENSUS_WRITE}")
endif()

# ---- the judgement ------------------------------------------------------------------------------

zen_census_judge("${found}" "${census_ROWS}" "${base_rows}" judged unmarked)
zen_census_judge_counts("${counted}" "${census_COUNTS}" "${base_counts}" counted_judged counted_unmarked)
list(APPEND judged ${counted_judged})
set(ZEN_CENSUS_REACH_WORDS "against the built-apart law")
zen_census_judge("${law_found}" "${census_REACHES}" "${base_reaches}" law_judged law_unmarked)
unset(ZEN_CENSUS_REACH_WORDS)
foreach(p IN LISTS law_judged)
    if(p MATCHES "^([^ ]+) includes ([^ ]+) against the built-apart law")
        set(pf "${CMAKE_MATCH_1}")
        set(ph "${CMAKE_MATCH_2}")
        set(lines "")
        foreach(w IN LISTS law_where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|](.*)$" AND CMAKE_MATCH_1 STREQUAL pf AND CMAKE_MATCH_2 STREQUAL ph)
                list(APPEND lines "${CMAKE_MATCH_3}")
            endif()
        endforeach()
        string(REPLACE ";" ", " lines "${lines}")
        set(p "${p} (${lines})")
    endif()
    list(APPEND problems "${p}")
endforeach()
foreach(p IN LISTS judged)
    # Each reach no row pins, or whose row moved, names the lines that cross.
    if(p MATCHES "^([^ ]+) includes ([^ ]+) across the line")
        set(pf "${CMAKE_MATCH_1}")
        set(ph "${CMAKE_MATCH_2}")
        set(lines "")
        foreach(w IN LISTS where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|](.*)$" AND CMAKE_MATCH_1 STREQUAL pf AND CMAKE_MATCH_2 STREQUAL ph)
                list(APPEND lines "${CMAKE_MATCH_3}")
            endif()
        endforeach()
        string(REPLACE ";" ", " lines "${lines}")
        set(p "${p} (${lines})")
    endif()
    list(APPEND problems "${p}")
endforeach()

list(LENGTH found row_count)
list(LENGTH counted counted_count)
list(LENGTH census_COUNTS counted_pinned)
list(LENGTH census_ROWS pinned_count)
list(LENGTH installed installed_count)
list(LENGTH law_found law_row_count)
list(LENGTH census_REACHES law_pinned)
message(STATUS "census: ${source_count} sources read under ${CMAKE_HOST_SYSTEM_NAME}, ${workshop_files} "
               "of them on Workshop's side; ${installed_count} headers the package installs; "
               "${toward_workshop} include lines from Zengine's side into Workshop's and "
               "${toward_zengine} from Workshop's into Zengine's uninstalled headers, in ${row_count} "
               "pairs; ${pinned_count} rows pinned, ${unmarked} not marked to fall; ${counted_count} "
               "counts of doors, hooks and lines read, ${counted_pinned} rows pinned, "
               "${counted_unmarked} not marked to fall; under the built-apart law ${law_source_count} sources "
               "read, ${law_edges} include lines it refuses, in ${law_row_count} pairs, ${law_pinned} rows pinned, "
               "${law_unmarked} not marked to fall; ${base_said}")
if(problems)
    list(LENGTH problems problem_count)
    string(REPLACE ";" "\n  " shown "${problems}")
    message(FATAL_ERROR "census FAILED: ${problem_count} problem(s):\n  ${shown}")
endif()
message(STATUS "census: PASSED -- every reach across the line, every include the built-apart law "
               "refuses and every count is pinned by its row, and no row marked to fall rose")
