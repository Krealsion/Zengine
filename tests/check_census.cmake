#
# The `census` entry (VM-CHECK-17): every row of tests/census.txt held by the tree, in either
# direction, and a row marked `falls` never raised against the base (ZEN_BASE, else the merge-base
# with origin/main). Its rows are the line between Workshop and Zengine (agents/workshop-line.md).
#   cmake -P tests/check_census.cmake                 (from the repository root, or -DZEN_REPO=<repo>)
#   cmake -DZEN_CENSUS_WRITE=<file> -P tests/check_census.cmake   (the census as the tree stands)

cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ZEN_REPO OR ZEN_REPO STREQUAL "")
    set(ZEN_REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
get_filename_component(ZEN_REPO "${ZEN_REPO}" ABSOLUTE)
if(NOT EXISTS "${ZEN_REPO}/AGENTS.md" OR NOT EXISTS "${ZEN_REPO}/tests/census.txt")
    message(FATAL_ERROR "census: '${ZEN_REPO}' is not this repository's root (no AGENTS.md and "
                        "tests/census.txt). Pass -DZEN_REPO=<repository root>.")
endif()

set(ZEN_CENSUS_CODE_KINDS feature host library examples)
set(ZEN_CENSUS_SOURCES *.hpp *.h *.cpp *.c *.hpp.in *.h.in *.cpp.in)
set(ZEN_CENSUS_SIDES workshop zengine)

# ---- the readings, one place each so the self-test exercises the real ones -------------------

# The census's rows: `side <folder> <side>` and `line <file> <header> <count> [falls]`, `#` a
# comment. Each malformed row is a problem, never a row read some other way.
function(zen_census_parse text prefix)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(sides "")
    set(rows "")
    set(problems "")
    set(n 0)
    foreach(line IN LISTS lines)
        math(EXPR n "${n} + 1")
        if(line MATCHES "^[ \t]*(#|$)")
            continue()
        elseif(line MATCHES "^side[ \t]+([A-Za-z0-9_./-]+)/[ \t]+([a-z]+)[ \t]*$")
            set(folder "${CMAKE_MATCH_1}")
            set(side "${CMAKE_MATCH_2}")
            if(NOT side IN_LIST ZEN_CENSUS_SIDES)
                list(APPEND problems "census.txt:${n}: a side is `workshop` or `zengine`, not `${side}`")
            else()
                list(APPEND sides "${folder}/|${side}")
            endif()
        elseif(line MATCHES "^line[ \t]+([A-Za-z0-9_./-]+)[ \t]+([A-Za-z0-9_./-]+)[ \t]+([1-9][0-9]*)([ \t]+falls)?[ \t]*$")
            # The captures are copied before the loop below matches again (VM-CHECK-03).
            set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
            set(count "${CMAKE_MATCH_3}")
            set(mark "")
            if(CMAKE_MATCH_4)
                set(mark falls)
            endif()
            foreach(row IN LISTS rows)
                if(row MATCHES "^([^|]+[|][^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL key)
                    list(APPEND problems "census.txt:${n}: a second row for ${key}")
                endif()
            endforeach()
            list(APPEND rows "${key}|${count}|${mark}")
        else()
            list(APPEND problems "census.txt:${n}: not a row: `${line}` (`side <folder>/ <side>` or `line <file> <header> <count> [falls]`)")
        endif()
    endforeach()
    set(${prefix}_SIDES "${sides}" PARENT_SCOPE)
    set(${prefix}_ROWS "${rows}" PARENT_SCOPE)
    set(${prefix}_PROBLEMS "${problems}" PARENT_SCOPE)
endfunction()

# The headers the install file names, comments stripped: every token ending `.hpp` or `.h`.
function(zen_census_installed text out)
    string(REPLACE "\r" "" text "${text}")
    string(REGEX REPLACE "#[^\n]*" "" text "${text}")
    string(REGEX MATCHALL "[A-Za-z0-9_./-]+[.]hp?p?[ \t\n)\"]" tokens "${text}")
    set(found "")
    foreach(token IN LISTS tokens)
        string(REGEX REPLACE ".$" "" token "${token}")
        if(token MATCHES "[.](hpp|h)$" AND NOT token MATCHES "^[.]")
            list(APPEND found "${token}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES found)
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# The quoted includes of one source's text, a directive at the start of its line: a `#include`
# inside a comment or after code is not one.
function(zen_census_includes text out)
    string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*include[ \t]*\"[^\"\n]+\"" directives "${text}")
    set(found "")
    foreach(d IN LISTS directives)
        string(REGEX REPLACE "^.*\"([^\"]+)\"$" "\\1" d "${d}")
        list(APPEND found "${d}")
    endforeach()
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# Which side a repository path is on: the longest `side` row that holds it, else Zengine's; and a
# file the package installs is the package's, whichever folder holds it.
function(zen_census_side path sides installed out)
    set(best "")
    set(best_len -1)
    foreach(row IN LISTS sides)
        string(REPLACE "|" ";" parts "${row}")
        list(GET parts 0 folder)
        list(GET parts 1 side)
        string(LENGTH "${folder}" len)
        string(SUBSTRING "${path}" 0 ${len} head)
        if(head STREQUAL folder AND len GREATER best_len)
            set(best "${side}")
            set(best_len ${len})
        endif()
    endforeach()
    if(best STREQUAL "" OR path IN_LIST installed)
        set(best zengine)
    endif()
    set(${out} "${best}" PARENT_SCOPE)
endfunction()

# The judgement: `found` is a list of `<file>|<header>|<count>`, `rows` the census's, `base` the
# rows at the base (`-` when there is none to read). Its problems name each line to look at.
function(zen_census_judge found rows base out_problems out_unmarked)
    set(problems "")
    set(unmarked 0)
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 file)
        list(GET fp 1 header)
        list(GET fp 2 count)
        set(pinned "")
        foreach(r IN LISTS rows)
            string(REPLACE "|" ";" rp "${r}")
            list(GET rp 0 rfile)
            list(GET rp 1 rheader)
            if(rfile STREQUAL file AND rheader STREQUAL header)
                list(GET rp 2 pinned)
            endif()
        endforeach()
        if(pinned STREQUAL "")
            list(APPEND problems "${file} includes ${header} across the line ${count} time(s), and no row pins it")
        elseif(NOT pinned EQUAL count)
            list(APPEND problems "${file} includes ${header} across the line ${count} time(s), and its row says ${pinned}: the row is set to what the tree holds")
        endif()
    endforeach()
    foreach(r IN LISTS rows)
        string(REPLACE "|" ";" rp "${r}")
        list(GET rp 0 rfile)
        list(GET rp 1 rheader)
        list(GET rp 2 rcount)
        list(LENGTH rp rn)
        set(rmark "")
        if(rn GREATER 3)
            list(GET rp 3 rmark)
        endif()
        set(held 0)
        foreach(f IN LISTS found)
            if(f MATCHES "^([^|]+)[|]([^|]+)[|]")
                if(CMAKE_MATCH_1 STREQUAL rfile AND CMAKE_MATCH_2 STREQUAL rheader)
                    set(held 1)
                endif()
            endif()
        endforeach()
        if(NOT held)
            list(APPEND problems "the row for ${rfile} including ${rheader} pins ${rcount}, and the tree holds none: the row goes")
        endif()
        if(NOT rmark STREQUAL "falls")
            math(EXPR unmarked "${unmarked} + 1")
        elseif(NOT base STREQUAL "-")
            set(was 0)
            foreach(b IN LISTS base)
                string(REPLACE "|" ";" bp "${b}")
                list(GET bp 0 bfile)
                list(GET bp 1 bheader)
                if(bfile STREQUAL rfile AND bheader STREQUAL rheader)
                    list(GET bp 2 was)
                endif()
            endforeach()
            if(rcount GREATER was)
                list(APPEND problems "the row for ${rfile} including ${rheader} is marked to only fall, and it rose from ${was} at the base to ${rcount}")
            endif()
        endif()
    endforeach()
    set(${out_problems} "${problems}" PARENT_SCOPE)
    set(${out_unmarked} ${unmarked} PARENT_SCOPE)
endfunction()

# ---- the self-test: make it say NO, and make it say YES (VM-CHECK-01) ----------------------------

set(st_failed "")
zen_census_includes("#include \"a/b.hpp\"\n// #include \"c/d.hpp\"\n  #  include \"e/f.h\" // x\nint x; #include \"g.hpp\"\n#include <h/i.hpp>\n" st_inc)
if(NOT st_inc STREQUAL "a/b.hpp;e/f.h")
    list(APPEND st_failed "the includes read as '${st_inc}', want 'a/b.hpp;e/f.h'")
endif()
zen_census_installed("set(x a/b.hpp\n    c/d.h)  # e/f.hpp\ninstall(FILES g/h.hpp DESTINATION y)\n" st_inst)
if(NOT st_inst STREQUAL "a/b.hpp;c/d.h;g/h.hpp")
    list(APPEND st_failed "the installed headers read as '${st_inst}', want 'a/b.hpp;c/d.h;g/h.hpp'")
endif()
zen_census_parse("# c\nside w/ workshop\nside w/m/ zengine\nline a/b.hpp w/c.hpp 2 falls\nline a/d.hpp w/c.hpp 1\nbad row\n" st)
list(LENGTH st_PROBLEMS st_np)
if(NOT st_SIDES STREQUAL "w/|workshop;w/m/|zengine" OR NOT st_ROWS STREQUAL "a/b.hpp|w/c.hpp|2|falls;a/d.hpp|w/c.hpp|1|"
   OR NOT st_np EQUAL 1)
    list(APPEND st_failed "the census read as sides '${st_SIDES}', rows '${st_ROWS}' and ${st_np} problem(s), want two sides, two rows and the bad row")
endif()
foreach(st_case "w/x.hpp|workshop" "w/m/x.cpp|zengine" "a/x.hpp|zengine" "w/i.hpp|zengine")
    string(REPLACE "|" ";" st_case "${st_case}")
    list(GET st_case 0 st_path)
    list(GET st_case 1 st_want)
    zen_census_side("${st_path}" "${st_SIDES}" "w/i.hpp" st_got)
    if(NOT st_got STREQUAL st_want)
        list(APPEND st_failed "${st_path} read as ${st_got}'s side, want ${st_want}'s")
    endif()
endforeach()
# The same tree as the rows, then a reach no row pins, a row the tree no longer holds, a row
# whose count moved, and a marked row raised against its base; an unmarked row may rise.
zen_census_judge("a/b.hpp|w/c.hpp|2;a/d.hpp|w/c.hpp|1" "${st_ROWS}" "a/b.hpp|w/c.hpp|2" st_p st_u)
if(st_p OR NOT st_u EQUAL 1)
    list(APPEND st_failed "the tree its rows pin read as '${st_p}' with ${st_u} unmarked, want no problem and 1")
endif()
zen_census_judge("a/b.hpp|w/c.hpp|2;a/d.hpp|w/c.hpp|1;a/e.hpp|w/c.hpp|1" "${st_ROWS}" "-" st_p st_u)
if(NOT st_p MATCHES "a/e[.]hpp includes w/c[.]hpp .*no row pins it")
    list(APPEND st_failed "a reach no row pins read as '${st_p}'")
endif()
zen_census_judge("a/d.hpp|w/c.hpp|1" "${st_ROWS}" "-" st_p st_u)
if(NOT st_p MATCHES "a/b[.]hpp including w/c[.]hpp pins 2, and the tree holds none")
    list(APPEND st_failed "a row the tree no longer holds read as '${st_p}'")
endif()
zen_census_judge("a/b.hpp|w/c.hpp|1;a/d.hpp|w/c.hpp|1" "${st_ROWS}" "-" st_p st_u)
if(NOT st_p MATCHES "its row says 2")
    list(APPEND st_failed "a row whose count fell read as '${st_p}'")
endif()
zen_census_judge("a/b.hpp|w/c.hpp|2;a/d.hpp|w/c.hpp|1" "${st_ROWS}" "a/b.hpp|w/c.hpp|1;a/d.hpp|w/c.hpp|0" st_p st_u)
list(LENGTH st_p st_pn)
if(NOT st_p MATCHES "marked to only fall, and it rose from 1 at the base to 2" OR NOT st_pn EQUAL 1)
    list(APPEND st_failed "a marked row raised against its base read as '${st_p}' (an unmarked one may rise)")
endif()
if(st_failed)
    string(REPLACE ";" "\n  " shown "${st_failed}")
    message(FATAL_ERROR "census: SELF-TEST FAILED -- the readings would judge the tree wrongly:\n  ${shown}")
endif()

# ---- the census, the package's headers and the base ------------------------------------------

file(READ "${ZEN_REPO}/tests/census.txt" census_text)
zen_census_parse("${census_text}" census)
set(problems ${census_PROBLEMS})
if(census_SIDES STREQUAL "")
    list(APPEND problems "tests/census.txt names no side: every file would be Zengine's and nothing would cross")
endif()

file(READ "${ZEN_REPO}/cmake/ZengineInstall.cmake" install_text)
zen_census_installed("${install_text}" installed)
foreach(h IN LISTS installed)
    if(NOT EXISTS "${ZEN_REPO}/${h}")
        list(APPEND problems "cmake/ZengineInstall.cmake names ${h}, which is no file of the tree: the package's headers are misread")
    endif()
endforeach()
if(NOT "pane/vocabulary.hpp" IN_LIST installed)
    list(APPEND problems "the package's headers read from cmake/ZengineInstall.cmake hold no pane/vocabulary.hpp: they are misread")
endif()

# The base: what the marked rows are held to. With no Git, no base or no census at it, nothing
# is held and the check says so.
set(base_rows "-")
set(base_said "no base was read")
find_program(ZEN_CENSUS_GIT git)
if(ZEN_CENSUS_GIT)
    if(NOT DEFINED ZEN_BASE OR ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" merge-base HEAD origin/main
                        RESULT_VARIABLE rc OUTPUT_VARIABLE ZEN_BASE ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT rc EQUAL 0)
            set(ZEN_BASE "")
            set(base_said "no base was read: `git merge-base HEAD origin/main` failed, so no marked row is held to one (ZEN_BASE names one)")
        endif()
    endif()
    if(NOT ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" show "${ZEN_BASE}:tests/census.txt"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE base_text ERROR_QUIET)
        if(rc EQUAL 0)
            zen_census_parse("${base_text}" base)
            set(base_rows "${base_ROWS}")
            set(base_said "marked rows held to the base ${ZEN_BASE}")
        else()
            set(base_said "the base ${ZEN_BASE} holds no tests/census.txt, so no marked row is held to one")
        endif()
    endif()
else()
    set(base_said "no base was read: no git was found, so no marked row is held to one")
endif()

# ---- the tree --------------------------------------------------------------------------------

file(STRINGS "${ZEN_REPO}/tests/folders.txt" folder_rows REGEX "^[^#]")
set(roots "")
foreach(row IN LISTS folder_rows)
    if(row MATCHES "^([^ \t]+)[ \t]+([a-z]+)[ \t]*$" AND CMAKE_MATCH_2 IN_LIST ZEN_CENSUS_CODE_KINDS)
        list(APPEND roots "${CMAKE_MATCH_1}")
    endif()
endforeach()
set(sources "")
foreach(root IN LISTS roots)
    set(globs "")
    foreach(pattern IN LISTS ZEN_CENSUS_SOURCES)
        list(APPEND globs "${ZEN_REPO}/${root}/${pattern}")
    endforeach()
    file(GLOB_RECURSE found_here RELATIVE "${ZEN_REPO}" ${globs})
    list(APPEND sources ${found_here})
endforeach()
list(LENGTH sources source_count)
if(source_count EQUAL 0)
    message(FATAL_ERROR "census: no source was found under the code folders of tests/folders.txt; an empty tree would pass")
endif()

set(found "")
set(where "")
set(workshop_files 0)
set(toward_workshop 0)
set(toward_zengine 0)
foreach(src IN LISTS sources)
    zen_census_side("${src}" "${census_SIDES}" "${installed}" from)
    if(from STREQUAL "workshop")
        math(EXPR workshop_files "${workshop_files} + 1")
    endif()
    file(READ "${ZEN_REPO}/${src}" text)
    zen_census_includes("${text}" heads)
    if(heads STREQUAL "")
        continue()
    endif()
    get_filename_component(dir "${src}" DIRECTORY)
    set(here "")
    foreach(h IN LISTS heads)
        if(EXISTS "${ZEN_REPO}/${dir}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${dir}/${h}")
            get_filename_component(abs "${ZEN_REPO}/${dir}/${h}" ABSOLUTE)
            file(RELATIVE_PATH target "${ZEN_REPO}" "${abs}")
        elseif(EXISTS "${ZEN_REPO}/${h}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${h}")
            set(target "${h}")
        else()
            continue()
        endif()
        zen_census_side("${target}" "${census_SIDES}" "${installed}" to)
        if(from STREQUAL to)
            continue()
        endif()
        if(from STREQUAL "workshop" AND target IN_LIST installed)
            continue()
        endif()
        list(APPEND here "${target}")
        if(to STREQUAL "workshop")
            math(EXPR toward_workshop "${toward_workshop} + 1")
        else()
            math(EXPR toward_zengine "${toward_zengine} + 1")
        endif()
        # The line of the file it stands on, for the problem that names it.
        string(REGEX MATCH "(^|\n)[ \t]*#[ \t]*include[ \t]*\"${h}\"" hit "${text}")
        string(FIND "${text}" "${hit}" at)
        string(SUBSTRING "${text}" 0 ${at} before)
        string(REGEX MATCHALL "\n" breaks "${before}")
        list(LENGTH breaks n)
        if(hit MATCHES "^\n")
            math(EXPR n "${n} + 2")
        else()
            math(EXPR n "${n} + 1")
        endif()
        list(APPEND where "${src}|${target}|${src}:${n}")
    endforeach()
    list(REMOVE_DUPLICATES here)
    foreach(target IN LISTS here)
        set(count 0)
        foreach(w IN LISTS where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL src AND CMAKE_MATCH_2 STREQUAL target)
                math(EXPR count "${count} + 1")
            endif()
        endforeach()
        list(APPEND found "${src}|${target}|${count}")
    endforeach()
endforeach()
if(workshop_files EQUAL 0)
    message(FATAL_ERROR "census: no source is on Workshop's side; the side rows of tests/census.txt hold nothing, and nothing could cross")
endif()

# ---- write mode: the census as the tree stands ------------------------------------------------

if(DEFINED ZEN_CENSUS_WRITE)
    set(out "")
    string(REPLACE "\r" "" census_text_lf "${census_text}")
    string(REGEX MATCH "^(#[^\n]*\n)+" head "${census_text_lf}")
    string(APPEND out "${head}\n")
    foreach(s IN LISTS census_SIDES)
        string(REPLACE "|" " " s "${s}")
        string(APPEND out "side ${s}\n")
    endforeach()
    string(APPEND out "\n")
    list(SORT found)
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 file)
        list(GET fp 1 header)
        list(GET fp 2 count)
        set(mark " falls")
        foreach(r IN LISTS census_ROWS)
            if(r MATCHES "^([^|]+)[|]([^|]+)[|][0-9]+[|]$" AND CMAKE_MATCH_1 STREQUAL file AND CMAKE_MATCH_2 STREQUAL header)
                set(mark "")
            endif()
        endforeach()
        string(APPEND out "line ${file} ${header} ${count}${mark}\n")
    endforeach()
    # LF on every host, as the census is committed.
    file(CONFIGURE OUTPUT "${ZEN_CENSUS_WRITE}" CONTENT "${out}" @ONLY NEWLINE_STYLE UNIX)
    message(STATUS "census: wrote the census as the tree stands to ${ZEN_CENSUS_WRITE}")
endif()

# ---- the judgement ------------------------------------------------------------------------------

zen_census_judge("${found}" "${census_ROWS}" "${base_rows}" judged unmarked)
foreach(p IN LISTS judged)
    # Each reach no row pins, or whose row moved, names the lines that cross.
    if(p MATCHES "^([^ ]+) includes ([^ ]+) across the line")
        set(pf "${CMAKE_MATCH_1}")
        set(ph "${CMAKE_MATCH_2}")
        set(lines "")
        foreach(w IN LISTS where)
            if(w MATCHES "^([^|]+)[|]([^|]+)[|](.*)$" AND CMAKE_MATCH_1 STREQUAL pf AND CMAKE_MATCH_2 STREQUAL ph)
                list(APPEND lines "${CMAKE_MATCH_3}")
            endif()
        endforeach()
        string(REPLACE ";" ", " lines "${lines}")
        set(p "${p} (${lines})")
    endif()
    list(APPEND problems "${p}")
endforeach()

list(LENGTH found row_count)
list(LENGTH census_ROWS pinned_count)
list(LENGTH installed installed_count)
message(STATUS "census: ${source_count} sources read under ${CMAKE_HOST_SYSTEM_NAME}, ${workshop_files} "
               "of them on Workshop's side; ${installed_count} headers the package installs; "
               "${toward_workshop} include lines from Zengine's side into Workshop's and "
               "${toward_zengine} from Workshop's into Zengine's uninstalled headers, in ${row_count} "
               "pairs; ${pinned_count} rows pinned, ${unmarked} not marked to fall; ${base_said}")
if(problems)
    list(LENGTH problems problem_count)
    string(REPLACE ";" "\n  " shown "${problems}")
    message(FATAL_ERROR "census FAILED: ${problem_count} problem(s):\n  ${shown}")
endif()
message(STATUS "census: PASSED -- every reach across the line is pinned by its row, and no row "
               "marked to fall rose")
