    list(GET st_case 0 st_fk)
    list(GET st_case 1 st_fp)
    list(GET st_case 2 st_hk)
    list(GET st_case 3 st_hp)
    list(GET st_case 4 st_hh)
    list(GET st_case 5 st_want)
    zen_census_refused("${st_fk}" "${st_fp}" "${st_hk}" "${st_hp}" ${st_hh} st_no)
    if(NOT st_no EQUAL st_want)
        list(APPEND st_failed "a ${st_fk} in ${st_fp} including a ${st_hk} of ${st_hp} (in a host's folder: ${st_hh}) read as refused ${st_no}, want ${st_want}")
