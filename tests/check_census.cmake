    list(APPEND st_failed "a new reach against the law read as '${st_p}'")
endif()
zen_census_parse("reach t/a.cpp w/s.hpp 2 falls\n" st)
zen_census_judge("t/a.cpp|w/s.hpp|2" "${st_REACHES}" "t/a.cpp|w/s.hpp|1|falls" st_p st_u)
