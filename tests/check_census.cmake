# A class a row pins is counted below the threshold, so its row keeps holding it.
set(ZEN_CENSUS_PINNED_LINES "a.hpp|C")
set(ZEN_CENSUS_COUNTING a.hpp)
zen_census_counts("class C {\n    int a;\n};\nclass D {\n    int b;\n};\n" 2 4 st_counts st_cp)
set(ZEN_CENSUS_PINNED_LINES "")
if(NOT st_counts STREQUAL "lines|C|3" OR st_cp)
